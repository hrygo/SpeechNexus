            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "const": "pronunciation_contract_violation"
                        },
                        "type": {
                          "const": "api_error"
                        },
                        "retryable": {
                          "const": false
                        },
                        "nexus": false
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "PronunciationSetConflict": {
        "description": "`pronunciation_idempotency_conflict`: the Idempotency-Key identifies\nanother intent. `pronunciation_configuration_changed`: an append's\n`expected_revision` is not the current allocation head.\n`pronunciation_outcome_unknown`: a keyless submission may already have\ncommitted, so resubmitting would create another set; reconcile the\noriginal attempt before deciding to submit again. None of these is\nretryable unchanged.\n",
        "headers": {
          "Cache-Control": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Should-Retry": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "false"
            }
          }
