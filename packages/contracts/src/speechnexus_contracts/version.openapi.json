{
  "openapi": "3.1.0",
  "info": {
    "title": "SpeechNexus public speech API",
    "version": "0.1.0.dev18",
    "description": "SpeechNexus public speech protocol.\n\nThe OpenAI-compatible subset is limited to the paths, fields, formats, and\nevents explicitly declared here. A standard OpenAI SDK can use this API by\nsetting base_url to <deployment>/v1 and supplying any api_key value unless\nthe deployment enables a shared service key. SpeechNexus enhancements live\nunder /v1/nexus and the optional `nexus` request field; a standard request\nnever needs an enhancement wrapper. Unsupported standard parameters are\nrejected with 422 `unsupported_parameter`, never silently ignored.\n\nRealtime has two connection modes at GET /v1/realtime: a pre-created\nnexus session (`session_id`) and a compatibility transcription session\nopened with `model`. Both accept the declared standard transcription\nevent subset. TTS, previews, metadata, and operation coordination remain\nnexus.* events and are available only in a nexus-created session.\n\nOne admission cause has one code per surface, and the two surfaces group them\ndifferently: the Job surface separates the four engine-side causes as\n`engine_not_ready`, `engine_state_mismatch`, `engine_resource_disabled` and\n`recipe_not_admitted`, while the voice-draft surface answers all four as\n`voice_draft_engine_unavailable` because the client action is identical and the\nmessage names the cause. Both are 503 with `retryable: false`.\n"
  },
  "security": [
    {
      "SharedServiceKey": []
    },
    {}
  ],
  "paths": {
    "/v1/nexus/version": {
      "get": {
        "tags": ["version"],
        "operationId": "getVersionIdentity",
        "summary": "Report the API version and canonical contract digest",
        "description": "Returns the API package version and the digest of the canonical contract\nsources this process was generated from. A browser consumer bakes in the\nsame digest at build time and compares it on start-up, so a deployment\nwhose frontend and API came from different contract revisions shows the\ndifference instead of interpreting new responses with old types.\n\nThe digest covers the machine contract sources under `contracts/` (every\n`*.yaml` and `*.json` file): SHA-256 over each file's relative path and\nits own SHA-256, in sorted path order. It is not a git revision and\nexposes no endpoint, identity, credential or filesystem path.\n`scripts/dev-env/print-contract-digest.py` recomputes it offline. A\nconsumer must never cache this response.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "API package version and canonical contract digest.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionIdentity"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "XRequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Validated client request ID or a server-generated correlation ID.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "VersionIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "contract_digest"],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "API package version, the same value `/healthz` reports."
          },
          "contract_digest": {
            "$ref": "#/components/schemas/Sha256Digest",
            "description": "Digest of the canonical contract sources this process was generated\nfrom. Equal digest values mean the API and the browser consumer\ncompiled the same contracts.\n"
          }
        }
      },
      "Sha256Digest": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Sha256Digest"
      },
      "External_shared_identifiers_schema_json_Sha256Digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "ErrorResponse": {
        "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorResponse"
      },
      "External_shared_errors_schema_json_ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorBody"
          }
        }
      },
      "External_shared_errors_schema_json_ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "type", "message", "param", "request_id", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "description": "Stable machine-readable error code."
          },
          "type": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorType"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "param": {
            "type": ["string", "null"],
            "maxLength": 128
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether the same request can succeed without an out-of-band change. The value belongs to the refusing operation's disposition, not to the status or the code: one operation's 409 may ask the caller to wait out a cleanup (retryable) while another 409 in the same operation reports a spent idempotency key (not retryable), so a caller reads this field instead of inferring retryability from the status. `true` means repeating the same request later can be admitted with no operator, configuration or data change: a released capacity lease, a concurrent writer finishing, a connection-level outcome that the original identity replays, and a cleanup that completes on its own all qualify. `false` means the same request is answered the same way until something outside the request changes, and the operation's published code and message name that change: provisioning the workspace quota, re-signing an engine readiness receipt, restoring a disabled instance, or re-registering against an approved recipe. The field never grants permission to drop an identity: a replayed unknown outcome is recovered under its original Idempotency-Key because the outcome is unknown, not because a value permits it, and every operation states that requirement in its own 5xx vocabulary. The meaning is per operation rather than global, so an operation that publishes a per-code value states it in its own contract (`contracts/workbench-openapi.yaml` for the workbench operations) instead of restating this field."
          },
          "retry_after_ms": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "nexus": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_OperationRecovery"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "enum": ["operation_in_progress", "response_not_replayable"]
                }
              }
            },
            "then": {
              "required": ["nexus"]
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "response_not_replayable"
                }
              }
            },
            "then": {
              "properties": {
                "nexus": {
                  "required": ["receipt"]
                }
              }
            }
          }
        ]
      },
      "External_shared_errors_schema_json_ErrorType": {
        "type": "string",
        "enum": [
          "invalid_request_error",
          "authentication_error",
          "permission_error",
          "not_found_error",
          "rate_limit_error",
          "api_error",
          "service_unavailable_error"
        ]
      },
      "External_shared_errors_schema_json_OperationRecovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id"],
        "properties": {
          "operation_id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "receipt": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_ExecutionReceipt"
          }
        },
        "description": "Query GET /v1/nexus/operations/{operation_id}. This identity is the original execution; retrying never creates a second execution."
      },
      "External_shared_identifiers_schema_json_Identifier": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
        "minLength": 3,
        "maxLength": 128,
        "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
      },
      "External_shared_receipts_schema_json_ExecutionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "requested", "effective", "observed", "missing", "unknown"],
        "properties": {
          "receipt_id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "request_id": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 128
          },
          "requested": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "effective": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "observed": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "missing": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_receipts_schema_json_ReceiptFactPath"
            }
          },
          "unknown": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_receipts_schema_json_ReceiptFactPath"
            }
          }
        }
      },
      "External_shared_receipts_schema_json_PublicExecutionFacts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "$ref": "#/components/schemas/External_shared_language_schema_json_LanguageTag"
          },
          "seed": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_seed"
          },
          "speed": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_speed"
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "maximum": 384000
          },
          "response_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AudioFormat"
              },
              {
                "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_TranscriptFormat"
              }
            ]
          },
          "max_segment_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_max_segment_ms"
          },
          "model_binding": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "profile": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "voice": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "pronunciation": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "turn_detection": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_turn_detection"
          },
          "finalization": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_finalization"
          },
          "preview_interval_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_preview_interval_ms"
          },
          "rollback_tokens": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_rollback_tokens"
          },
          "final_deadline_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_final_deadline_ms"
          },
          "auxiliary_deadline_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_auxiliary_deadline_ms"
          },
          "alignment": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_alignment"
          },
          "diarization": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_diarization"
          },
          "vocabulary_set_revision": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_vocabulary_set_revision"
          },
          "text_commit_mode": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_text_commit_mode"
          },
          "audio_delivery": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_audio_delivery"
          },
          "pronunciation_revision": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_pronunciation_revision"
          },
          "planner": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_planner"
          },
          "instructions_present": {
            "type": "boolean"
          },
          "prompt_present": {
            "type": "boolean"
          },
          "policy": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "vocabulary": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          }
        },
        "description": "Allowlisted public projection only. Omit content, prompt, instructions, vendor payloads and private runtime identities. Unknown facts go into stable missing/unknown paths, never arbitrary dictionaries."
      },
      "External_shared_language_schema_json_LanguageTag": {
        "type": "string",
        "pattern": "^(auto|[a-z]{2,3}(-[A-Za-z0-9]{2,8})*)$",
        "maxLength": 35
      },
      "External_shared_speech_overrides_schema_json_seed": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 2147483647
      },
      "External_shared_speech_overrides_schema_json_speed": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 4.0
      },
      "External_shared_capability_domains_schema_json_AudioFormat": {
        "type": "string",
        "enum": ["mp3", "wav", "pcm"]
      },
      "External_shared_capability_domains_schema_json_TranscriptFormat": {
        "type": "string",
        "enum": ["json", "text", "verbose_json", "srt", "vtt"]
      },
      "External_shared_speech_overrides_schema_json_max_segment_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000
      },
      "External_shared_references_schema_json_ResourceReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "revision": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
          }
        }
