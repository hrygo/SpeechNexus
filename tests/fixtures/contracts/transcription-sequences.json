{
  "source": "docs/architecture/speech-api.md sections 2.2-2.4",
  "scope": "All event shapes validate; semantic expectations require the actual C4 reducer/A05 producer. No operation completion, budget release, real ASR or network qualification is implied.",
  "examples": [
    {
      "id": "manual-commit-completion",
      "semantic_valid": true,
      "rule": "commit_closes_input_segment",
      "steps": [
        {
          "direction": "server",
          "value": {
            "type": "session.created",
            "event_id": "event-created-demo",
            "session": {
              "id": "session-demo",
              "object": "realtime.transcription_session",
              "type": "transcription",
              "audio": {
                "input": {
                  "format": {
                    "type": "audio/pcm",
                    "rate": 24000
                  },
                  "transcription": {
                    "model": "asr-quality"
                  },
                  "turn_detection": null
                }
              },
              "expires_at": 1792800030,
              "nexus": {
                "limits": {
                  "max_input_chunk_ms": 100,
                  "max_message_bytes": 65536,
                  "input_credit_samples": 24000,
                  "output_credit_samples": 0,
                  "max_segment_ms": 20000,
                  "max_session_duration_ms": 3600000
                }
              }
            }
          }
        },
        {
          "direction": "client",
          "value": {
            "type": "session.update",
            "session": {
              "type": "transcription",
              "audio": {
                "input": {
                  "format": {
                    "type": "audio/pcm"
                  },
                  "transcription": {
                    "model": "asr-quality"
                  }
                }
              }
            }
          }
        },
        {
          "direction": "server",
          "value": {
            "type": "session.updated",
            "event_id": "event-updated-demo",
            "session": {
              "id": "session-demo",
              "object": "realtime.transcription_session",
              "type": "transcription",
              "audio": {
                "input": {
                  "format": {
                    "type": "audio/pcm",
                    "rate": 24000
                  },
                  "transcription": {
                    "model": "asr-quality"
                  },
                  "turn_detection": null
                }
              },
              "expires_at": 1792800030,
              "nexus": {
                "limits": {
                  "max_input_chunk_ms": 100,
                  "max_message_bytes": 65536,
                  "input_credit_samples": 24000,
                  "output_credit_samples": 0,
                  "max_segment_ms": 20000,
                  "max_session_duration_ms": 3600000
                }
              }
            }
          }
        },
        {
          "direction": "client",
          "value": {
            "type": "input_audio_buffer.append",
            "event_id": "event-append-demo",
            "audio": "<synthetic-pcm16>"
          },
          "synthetic_pcm_bytes": 4800
        },
        {
          "direction": "client",
          "value": {
            "type": "input_audio_buffer.commit",
            "event_id": "event-commit-demo"
          }
        },
        {
          "direction": "server",
          "value": {
            "type": "input_audio_buffer.committed",
            "event_id": "event-committed-demo",
            "item_id": "item-demo",
            "previous_item_id": null
          }
        },
        {
          "direction": "server",
          "value": {
            "type": "conversation.item.input_audio_transcription.delta",
            "event_id": "event-delta-demo",
            "item_id": "item-demo",
            "content_index": 0,
