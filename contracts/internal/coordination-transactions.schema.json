    "TransactionErrorCode": {
      "anyOf": [
        {
          "enum": [
            "version_conflict",
            "owner_busy",
            "capacity_exhausted",
            "quota_exceeded",
            "recipe_mismatch",
            "output_overlap",
            "output_limit_exceeded",
            "outcome_unknown",
            "idempotency_conflict",
            "not_found",
            "invalid_counter",
            "reconciliation_required"
          ]
        },
        {
          "$ref": "./execution-control.openapi.yaml#/components/schemas/ExecutionErrorCode"
        },
        {
          "$ref": "./runtime-control.openapi.yaml#/components/schemas/RuntimeControlErrorResponse/properties/error/properties/code"
        }
      ]
    },
    "TransactionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "scope_id",
        "recovery",
        "schema_version",
        "operation"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "committed",
            "replayed",
            "conflict",
            "rejected",
            "unknown"
          ]
        },
        "scope_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        },
        "error_code": {
          "$ref": "#/$defs/TransactionErrorCode"
        },
        "recovery": {
          "enum": [
            "none",
            "retry_transaction",
            "query_original",
            "query_current_authority",
            "reconcile"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/OwnerSnapshot"
            },
            {
              "$ref": "#/$defs/AdmissionSnapshot"
            },
            {
              "$ref": "#/$defs/ClaimSnapshot"
            },
            {
              "$ref": "#/$defs/LeaseSnapshot"
            },
            {
              "$ref": "#/$defs/FactSnapshot"
            },
            {
              "$ref": "#/$defs/ExecutionSnapshot"
            },
            {
              "$ref": "#/$defs/RuntimeSnapshot"
            }
          ]
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "operation": {
          "enum": [
            "acquire_owner",
            "renew_owner",
            "seal_barrier",
            "activate_owner",
            "admit_recipe",
            "create_job",
            "claim_job",
            "create_submit",
            "record_stop",
            "quarantine_lease",
            "release_lease",
            "append_interval",
            "create_runtime_intent",
            "observe_runtime",
            "query_outcome",
            "mark_execution_unknown",
            "record_execution_observation",
            "redact_execution_command"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "committed",
                  "replayed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "recovery": {
                "const": "none"
              }
            },
            "not": {
              "required": [
                "error_code"
              ]
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "conflict",
                  "rejected",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": "outcome_unknown"
              },
              "recovery": {
                "enum": [
                  "query_original",
                  "query_current_authority",
                  "reconcile"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "acquire_owner",
                  "renew_owner",
                  "activate_owner"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/OwnerSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "admit_recipe"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/AdmissionSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "claim_job"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ClaimSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "release_lease",
                  "quarantine_lease"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/LeaseSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "seal_barrier",
                  "create_job",
                  "append_interval",
                  "redact_execution_command"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/FactSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "create_submit",
                  "mark_execution_unknown",
                  "record_stop",
                  "record_execution_observation"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ExecutionSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "create_runtime_intent",
                  "observe_runtime"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/RuntimeSnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "release_lease"
              },
              "outcome": {
                "enum": [
                  "committed",
                  "replayed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "lease_state": {
                    "const": "released"
                  }
                }
              }
            }
          }
        }
      ]
    },
