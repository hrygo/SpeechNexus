  "$defs": {
    "OwnerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "owner_id",
        "fencing_token"
      ],
      "properties": {
        "pool_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/PoolId"
        },
        "owner_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "AttemptIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "attempt_id"
      ],
      "properties": {
        "operation_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        }
      }
    },
    "StageAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "lease_id",
        "pool_id",
        "host_node_id",
        "gateway_id",
        "instance_id",
        "instance_generation",
        "expected_instance_version",
        "reserved_slots"
      ],
      "properties": {
        "stage_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "lease_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "pool_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/PoolId"
        },
        "host_node_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "gateway_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "instance_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "instance_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_instance_version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        },
        "reserved_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "PhysicalReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unified_physical_memory_bytes",
        "device_memory_bytes",
        "host_memory_bytes",
        "cpu_decode_millicores",
        "host_pcm_buffer_bytes",
        "scratch_disk_bytes"
      ],
      "properties": {
        "unified_physical_memory_bytes": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/unified_physical_memory_bytes"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "device_memory_bytes": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/device_memory_bytes"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "host_memory_bytes": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/host_memory_bytes"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "cpu_decode_millicores": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/cpu_decode_millicores"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "host_pcm_buffer_bytes": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/host_pcm_buffer_bytes"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "scratch_disk_bytes": {
          "allOf": [
            {
              "$ref": "../capacity-manifest.schema.json#/$defs/ResourceVector/properties/scratch_disk_bytes"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "VerifiedStopEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "submit_intent_id",
        "evidence_kind",
        "evidence_digest",
        "observed_at_us",
        "execution_stopped",
        "resources_released",
        "reason"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "submit_intent_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "evidence_kind": {
          "allOf": [
            {
              "$ref": "./execution-control.openapi.yaml#/components/schemas/StopEvidenceKind"
            },
            {
              "not": {
                "enum": [
                  "none",
                  "unconfirmed_timeout"
                ]
              }
            }
          ]
        },
        "evidence_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        },
        "observed_at_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "execution_stopped": {
          "const": true
        },
        "resources_released": {
          "const": true
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "../admin-openapi.yaml#/components/schemas/QuarantineReleaseRequest/properties/reason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "operator_verified_instance_terminated"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "Verified termination of this submitted execution and release of its incremental resources. This does not imply that the shared engine process exited; instance baseline release requires the separate RuntimeStopEvidence contract."
    },
    "JobIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "event_id",
        "event_digest"
      ],
      "properties": {
        "job_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "event_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "event_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        }
      }
    },
    "acquire_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "owner_id",
        "expected_version",
        "ttl_ms"
      ],
      "properties": {
        "pool_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/PoolId"
        },
        "owner_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "expected_version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "renew_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "expected_version",
        "ttl_ms"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/OwnerAuthority"
        },
        "expected_version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "seal_barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "barrier",
        "evidence_digest"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/OwnerAuthority"
        },
        "barrier": {
          "$ref": "./execution-control.openapi.yaml#/components/schemas/GatewayFencingBarrierResponse"
        },
        "evidence_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        }
      }
    },
    "activate_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "expected_version"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/OwnerAuthority"
        },
        "expected_version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        }
      }
    },
    "admit_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "workspace_id",
        "binding_revision_id",
        "manifest_id",
        "recipe_digest",
        "policy_revision_id",
        "expected_quota_version",
        "service_class",
        "authorities",
        "stages",
        "deadline_at_us",
        "job"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/AttemptIdentity"
        },
        "workspace_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "binding_revision_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "manifest_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "recipe_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        },
        "policy_revision_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "expected_quota_version": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Revision"
        },
        "service_class": {
          "$ref": "../shared/capability-domains.schema.json#/$defs/ServiceClass"
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/OwnerAuthority"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/StageAllocation"
          }
        },
        "deadline_at_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "job": {
          "$ref": "#/$defs/JobIdentity"
        }
      }
    },
    "create_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "identity",
        "request_digest"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/JobIdentity"
        },
        "identity": {
          "$ref": "#/$defs/AttemptIdentity"
        },
        "request_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        }
      }
    },
    "claim_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "worker_id",
        "expected_claim_version",
        "ttl_ms"
      ],
      "properties": {
        "job_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "worker_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "expected_claim_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "create_submit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_request",
        "output_stream_id"
      ],
      "properties": {
        "execution_request": {
          "$ref": "./execution-control.openapi.yaml#/components/schemas/SubmitExecutionRequest"
        },
        "output_stream_id": {
          "anyOf": [
            {
              "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_request": {
                "properties": {
                  "sample_rate_hz": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "output_stream_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "output_stream_id": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "record_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "terminal_state",
        "error_code"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/VerifiedStopEvidence"
        },
        "terminal_state": {
          "allOf": [
            {
              "$ref": "./execution-control.openapi.yaml#/components/schemas/ExecutionState"
            },
            {
              "enum": [
                "succeeded",
                "failed",
                "aborted"
              ]
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "./execution-control.openapi.yaml#/components/schemas/ExecutionErrorCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "evidence_kind": {
                    "const": "engine_terminal_response"
                  }
                }
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "error_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "quarantine_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "reason_code",
        "observed_at_us"
      ],
      "properties": {
        "lease_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
