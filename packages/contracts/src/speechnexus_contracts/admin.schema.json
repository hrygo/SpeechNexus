{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminContracts",
  "x-nexus-bindings-version": "0.1.0.dev0",
  "x-nexus-entrypoints": ["WorkspaceCreateRequest", "WorkspacePatch"],
  "$defs": {
    "WorkspaceCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "Identifier": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
    },
    "External_shared_identifiers_schema_json_Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
    },
    "WorkspacePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": ["expected_metadata_revision"],
      "properties": {
        "expected_metadata_revision": {
          "type": "integer",
          "minimum": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"]
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/WorkspaceCreateRequest"
    },
    {
      "$ref": "#/$defs/WorkspacePatch"
    }
  ]
}
