      "External_voice_resource_schema_json_VoiceRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "voice_id",
          "revision",
          "object",
          "status",
          "display_name",
          "source",
          "model_binding",
          "capabilities",
          "validation",
          "published_at",
          "retired_at",
          "disabled_reason"
        ],
        "properties": {
          "resource_type": {
            "const": "voice_revision"
          },
          "voice_id": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_Identifier"
          },
          "revision": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_Revision"
          },
          "object": {
            "const": "nexus.voice_revision"
          },
          "status": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_VoiceRevisionStatus"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_VoiceSource"
          },
          "model_binding": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_BindingReference"
          },
          "capabilities": {
            "$ref": "#/components/schemas/External_voice_resource_schema_json_VoiceCapabilities"
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validation_id", "status", "checked_at"],
            "properties": {
              "validation_id": {
                "$ref": "#/components/schemas/External_voice_resource_schema_json_Identifier"
              },
              "status": {
                "type": "string",
                "enum": ["passed"]
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "retired_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "disabled_reason": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "retired_at": {
                  "type": "null"
                },
                "disabled_reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "retired"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "retired_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "disabled_reason": {
                  "type": "null"
                }
              },
              "required": ["retired_at"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "disabled"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "retired_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "disabled_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": ["retired_at", "disabled_reason"]
            }
          }
        ]
      },
      "External_voice_resource_schema_json_Identifier": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
      },
      "External_voice_resource_schema_json_Revision": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
      },
      "External_voice_resource_schema_json_VoiceRevisionStatus": {
        "type": "string",
        "enum": ["published", "retired", "disabled"]
      },
      "External_voice_resource_schema_json_VoiceSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["designed", "cloned", "builtin"]
          },
          "draft_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/External_voice_resource_schema_json_Identifier"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft_revision": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/External_voice_resource_schema_json_Revision"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_asset_digest": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/External_voice_resource_schema_json_Sha256Digest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "builtin"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "draft_id": {
                  "type": "null"
                },
                "draft_revision": {
                  "type": "null"
                },
                "source_asset_digest": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "designed"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["draft_id", "draft_revision"],
              "properties": {
                "draft_id": {
                  "not": {
                    "type": "null"
                  }
                },
                "draft_revision": {
                  "not": {
                    "type": "null"
                  }
                },
                "source_asset_digest": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cloned"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["draft_id", "draft_revision", "source_asset_digest"],
              "properties": {
                "draft_id": {
                  "not": {
                    "type": "null"
                  }
                },
                "draft_revision": {
                  "not": {
                    "type": "null"
                  }
                },
                "source_asset_digest": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          }
        ]
      },
      "External_voice_resource_schema_json_Sha256Digest": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Sha256Digest"
      },
      "External_shared_identifiers_schema_json_Sha256Digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "External_voice_resource_schema_json_BindingReference": {
        "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
      },
      "External_voice_resource_schema_json_VoiceCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["languages", "sample_rates_hz", "audio_formats", "modes"],
        "properties": {
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_voice_resource_schema_json_LanguageTag"
            }
          },
          "sample_rates_hz": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 8000,
              "maximum": 96000
            }
          },
          "audio_formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AudioFormat"
            }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AudioDeliveryMode"
            }
          },
          "max_input_codepoints": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      },
      "External_voice_resource_schema_json_LanguageTag": {
        "$ref": "#/components/schemas/External_shared_language_schema_json_LanguageTag"
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Validated client request ID or a server-generated correlation ID.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying a capacity or cancellation coordination request.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Shared service credential required or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Backend or capacity unavailable; retry only when `retryable` is true.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found or not visible to the requested workspace.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "SharedServiceKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional deployment-wide shared credential. It grants access to the\nshared deployment, not a user identity. When disabled, any Authorization\nheader value is accepted for SDK compatibility and is not interpreted as\na user.\n"
      }
    }
  }
}
