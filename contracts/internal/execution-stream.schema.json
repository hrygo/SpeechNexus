{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/internal/execution-stream.schema.json",
  "title": "ExecutionStreamControlEvent",
  "description": "Internal WebSocket control event between the realtime gateway and execution gateway. JSON control frames carry identity, credits, watermarks, backpressure, and terminal evidence. PCM payloads travel in the fixed binary frame described by x-speechnexus-binary-frame; they are never base64-encoded in this protocol.",
  "x-speechnexus-transport-security": {
    "description": "The WebSocket handshake requires a component credential and TLS on the internal management network. Credentials are carried only in an approved handshake header or client certificate, never in stream.open, query parameters, logs, or PCM frames."
  },
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/StreamOpen"
    },
    {
      "$ref": "#/$defs/StreamOpened"
    },
    {
      "$ref": "#/$defs/StreamInputAck"
    },
    {
      "$ref": "#/$defs/StreamOutputAck"
    },
    {
      "$ref": "#/$defs/StreamBackpressure"
    },
    {
      "$ref": "#/$defs/StreamClose"
    },
    {
      "$ref": "#/$defs/StreamClosed"
    },
    {
      "$ref": "#/$defs/StreamErrorEvent"
    },
    {
      "$ref": "#/$defs/StreamHeartbeat"
    }
  ],
  "x-speechnexus-binary-frame": {
    "description": "Exactly one binary WebSocket message carries one PCM chunk. All integers are unsigned big-endian. The JSON stream.open event must be acknowledged by stream.opened before any binary frame is sent.",
    "header_bytes": 32,
    "fields": [
      {
        "name": "magic",
        "offset": 0,
        "bytes": 4,
        "value_ascii": "SNX1"
      },
      {
        "name": "version",
        "offset": 4,
        "bytes": 1,
        "value": 1
      },
      {
        "name": "frame_type",
        "offset": 5,
        "bytes": 1,
        "enum": {
          "1": "input_pcm",
          "2": "output_pcm"
        }
      },
      {
        "name": "flags",
        "offset": 6,
        "bytes": 2,
        "value": 0
      },
      {
        "name": "stream_epoch",
        "offset": 8,
        "bytes": 4
      },
      {
        "name": "chunk_seq",
        "offset": 12,
        "bytes": 4
      },
      {
        "name": "start_sample",
        "offset": 16,
        "bytes": 8
      },
      {
        "name": "sample_count",
        "offset": 24,
        "bytes": 4
      },
      {
        "name": "payload_bytes",
        "offset": 28,
        "bytes": 4
      }
    ],
    "invariants": [
      "payload_bytes equals the remaining message length and must be even for pcm_s16le.",
      "sample_count * 2 equals payload_bytes for pcm_s16le mono.",
      "chunk_seq is contiguous per frame_type and stream_epoch; a gap is a stream error, not silent loss.",
      "[start_sample, start_sample + sample_count) is a half-open interval on the negotiated wire clock.",
      "A frame with a stale stream_epoch is discarded and reported as stream.error without mutating execution state."
    ]
  },
  "$defs": {
    "Identifier": {
      "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
    },
    "CleanupState": {
      "$ref": "../shared/operation-states.schema.json#/$defs/CleanupState"
    },
    "TerminalOperationStatus": {
      "$ref": "../shared/operation-states.schema.json#/$defs/TerminalOperationStatus"
    },
    "PcmDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "sample_rate_hz",
        "channels"
      ],
      "properties": {
        "encoding": {
          "const": "pcm_s16le"
        },
        "sample_rate_hz": {
          "type": "integer",
          "enum": [
            16000,
            24000,
            48000
          ]
        },
        "channels": {
          "const": 1
        }
      }
    },
    "StreamError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_envelope",
            "stale_epoch",
            "credit_exceeded",
            "chunk_gap",
            "sample_mismatch",
            "unsupported_format",
            "execution_not_found",
            "execution_fenced",
            "adapter_failure",
            "cleanup_unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "BaseEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "stream_id",
        "stream_epoch",
        "seq",
        "sent_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "type": {
          "type": "string"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic per stream connection. Reconnect starts a new stream_epoch and resets seq; history is never spliced across epochs."
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "StreamOpen": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "type",
            "stream_id",
            "stream_epoch",
            "seq",
            "sent_at",
            "operation_id",
            "attempt_id",
            "submit_intent_id",
            "fencing_token",
            "input",
            "input_credit_samples",
            "max_message_bytes"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "type": {
              "const": "stream.open"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "attempt_id": {
              "$ref": "#/$defs/Identifier"
            },
            "submit_intent_id": {
              "$ref": "#/$defs/Identifier"
            },
            "fencing_token": {
              "type": "integer",
              "minimum": 1
            },
            "input": {
              "$ref": "#/$defs/PcmDescriptor"
            },
            "output": {
              "oneOf": [
                {
                  "$ref": "#/$defs/PcmDescriptor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "input_credit_samples": {
              "type": "integer",
              "minimum": 1
            },
            "max_message_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "StreamOpened": {
      "allOf": [
