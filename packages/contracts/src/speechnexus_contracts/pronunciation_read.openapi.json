{
  "openapi": "3.1.0",
  "info": {
    "title": "SpeechNexus public speech API",
    "version": "0.1.0.dev0",
    "description": "SpeechNexus public speech protocol.\n\nThe OpenAI-compatible subset is limited to the paths, fields, formats, and\nevents explicitly declared here. A standard OpenAI SDK can use this API by\nsetting base_url to <deployment>/v1 and supplying any api_key value unless\nthe deployment enables a shared service key. SpeechNexus enhancements live\nunder /v1/nexus and the optional `nexus` request field; a standard request\nnever needs an enhancement wrapper. Unsupported standard parameters are\nrejected with 422 `unsupported_parameter`, never silently ignored.\n\nRealtime has two connection modes at GET /v1/realtime: a pre-created\nnexus session (`session_id`) and a compatibility transcription session\nopened with `model`. Both accept the declared standard transcription\nevent subset. TTS, previews, metadata, and operation coordination remain\nnexus.* events and are available only in a nexus-created session.\n"
  },
  "security": [
    {
      "SharedServiceKey": []
    },
    {}
  ],
  "paths": {
    "/v1/nexus/pronunciation-sets/{pronunciation_id}/revisions/{revision}": {
      "get": {
        "tags": ["voices"],
        "operationId": "getPronunciationRevision",
        "summary": "Get one immutable pronunciation-set revision",
        "description": "Reads the exact requested revision; the returned status does not\nitself grant publication, execution, or pronunciation qualification.\nOnly a confirmed missing revision returns 404 pronunciation_not_found.\nUnreadable metadata returns 503 pronunciation_unavailable with\nretryable: true, not 404. Both replies are non-cacheable and carry the\nmatching X-Should-Retry value. Neither fabricates an Operation or\nauthorizes allocating a replacement revision. A caller may explicitly\nrepeat the same fixed GET; there is no implicit client retry.\n\nInvalid path/header/query values or a request body return 400.\nHost/Origin rejection (403), unsupported method (405 with Allow: GET),\nand local read capacity (429) concern this HTTP attempt, not the\nresource's publication or execution state.\n",
        "parameters": [
          {
            "name": "pronunciation_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          {
            "$ref": "#/components/parameters/RevisionPath"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable pronunciation revision.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/External_voice_resource_schema_json_PronunciationRevision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PronunciationReadForbidden"
          },
          "404": {
            "$ref": "#/components/responses/PronunciationReadNotFound"
          },
          "405": {
            "$ref": "#/components/responses/PronunciationReadMethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/PronunciationReadUnavailable"
          }
        }
      }
    }
  },
