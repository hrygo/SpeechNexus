{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/model-instance.schema.json",
  "title": "ModelRuntimeInstance",
  "description": "Dynamic runtime instance fact for a node-scoped engine process or container. This schema is internal to admin, scheduler, deployment controller, and execution gateway; it is not a public model or voice DTO. A new generation is required after every restart. Every observed fact is reported only when its producer actually recorded it; a producer that does not record a fact omits the member instead of synthesizing a value. `stop_evidence` is the instance-level physical stop document and never the execution-level lease or submit-intent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "host_node_id",
    "gateway_id",
    "binding",
    "binding_revision_id",
    "pool_id",
    "generation",
    "config_digest",
    "state",
    "readiness",
    "observed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "instance_id": {
      "$ref": "#/$defs/Identifier"
    },
    "host_node_id": {
      "$ref": "#/$defs/Identifier"
    },
    "gateway_id": {
      "$ref": "#/$defs/Identifier"
    },
    "binding": {
      "$ref": "#/$defs/BindingReference"
    },
    "binding_revision_id": {
      "$ref": "#/$defs/Identifier",
      "description": "Must equal ModelBindingRevision.revision_id for the referenced binding."
    },
    "pool_id": {
      "$ref": "#/$defs/PoolId"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per-instance generation allocated by the deployment controller. Stale generations must be fenced."
    },
    "config_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "state": {
      "$ref": "#/$defs/InstanceState"
    },
    "readiness": {
      "$ref": "#/$defs/ReadinessFacts"
    },
    "observed": {
      "$ref": "#/$defs/ObservedFacts"
    },
    "controller": {
      "$ref": "#/$defs/ControllerFacts"
    },
    "quarantine_reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "readiness": {
            "required": [
              "accepting_new_work",
              "ready_at"
            ],
            "properties": {
              "accepting_new_work": {
                "const": true
              },
              "ready_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "ready"
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "accepting_new_work": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "draining"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "accepting_new_work": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "stopped"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "observed": {
            "required": [
              "stopped_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "quarantined"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "quarantine_reason"
        ],
        "properties": {
          "quarantine_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "quarantined"
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "quarantine_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "$ref": "shared/identifiers.schema.json#/$defs/Identifier"
    },
    "Sha256Digest": {
      "$ref": "shared/identifiers.schema.json#/$defs/Sha256Digest"
    },
    "PoolId": {
      "$ref": "shared/identifiers.schema.json#/$defs/PoolId"
    },
    "InstanceState": {
      "$ref": "shared/runtime-states.schema.json#/$defs/InstanceState"
    },
    "BindingReference": {
      "$ref": "shared/references.schema.json#/$defs/ResourceReference"
    },
    "ReadinessFacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Readiness facts for this generation. `accepting_new_work` is always declared because it follows directly from `state`; the remaining members are present only when the producer observed and recorded them.",
      "required": [
        "accepting_new_work"
      ],
      "properties": {
        "accepting_new_work": {
          "type": "boolean"
        },
        "loaded_artifact_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Sha256Digest"
          },
          "description": "Digests of the exact artifacts this generation loaded, when the producer records the loaded set. An empty array records that nothing was loaded; an absent member records that the loaded set was not recorded."
        },
        "warmed_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(asr|tts|voice|audio)\\.[a-z0-9_.-]{2,64}$"
          },
          "description": "Capabilities this generation warmed, when the producer records the warmed set."
        },
        "ready_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time this generation began accepting new work, when recorded; null means the transition was not recorded."
        }
      }
    },
    "StopEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Instance-level physical stop evidence: the process or container exited, its reserved resources were released, and the observation was verified. Lease and submit-intent cleanup evidence is execution-level, carries its own kinds, and is not reported here.",
      "required": [
        "process_or_container_exited",
        "resources_released_confirmed",
        "verified_at"
      ],
      "properties": {
        "process_or_container_exited": {
          "const": true
        },
        "resources_released_confirmed": {
          "const": true
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "runtime_container_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "ObservedFacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Observed timing and termination facts for this generation. Every member is optional: a producer that did not record a fact omits it rather than inventing one.",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Recorded process or container start time. A producer that only tracks readiness and stop transitions does not record it."
        },
        "last_heartbeat_at": {
          "type": "string",
          "format": "date-time",
          "description": "Recorded most recent heartbeat. A producer without a heartbeat channel does not record it."
        },
        "stopped_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time the physical stop was verified, when recorded; null means the instance was not observed stopped."
        },
        "stop_evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/StopEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Instance-level physical stop evidence, when the producer recorded it."
        }
      }
    },
    "ControllerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_id",
        "intent_id"
      ],
      "properties": {
        "controller_id": {
          "$ref": "#/$defs/Identifier"
        },
        "intent_id": {
          "$ref": "#/$defs/Identifier"
        },
        "template_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "instance_id": "inst-asr-1",
      "host_node_id": "node-gb10-1",
      "gateway_id": "gateway-1",
      "binding": {
        "id": "asr-quality",
        "revision": "7"
      },
      "binding_revision_id": "mbrev-asr-quality-7",
      "pool_id": "asr-realtime",
      "generation": 42,
      "config_digest": "sha256:7777777777777777777777777777777777777777777777777777777777777777",
      "state": "ready",
      "readiness": {
        "accepting_new_work": true,
        "ready_at": "2026-10-22T09:00:10Z"
      },
      "observed": {
        "stopped_at": null,
        "stop_evidence": null
      },
      "controller": {
        "controller_id": "node-controller-1",
        "intent_id": "intent-prepare-42",
        "template_id": "approved-asr-realtime-v7"
      },
      "quarantine_reason": null
    },
    {
      "schema_version": "1.0.0",
      "instance_id": "inst-tts-2",
      "host_node_id": "node-gb10-1",
      "gateway_id": "gateway-1",
      "binding": {
        "id": "tts-interactive",
        "revision": "5"
      },
      "binding_revision_id": "mbrev-tts-interactive-5",
      "pool_id": "tts-realtime",
      "generation": 7,
      "config_digest": "sha256:8888888888888888888888888888888888888888888888888888888888888888",
      "state": "stopped",
      "readiness": {
        "accepting_new_work": false,
        "ready_at": "2026-10-22T08:00:00Z"
      },
      "observed": {
        "stopped_at": "2026-10-22T10:00:05Z",
        "stop_evidence": {
          "process_or_container_exited": true,
          "resources_released_confirmed": true,
          "verified_at": "2026-10-22T10:00:05Z",
          "exit_code": 0,
          "runtime_container_id": "container-tts-2"
        }
      },
      "controller": {
        "controller_id": "node-controller-1",
        "intent_id": "intent-stop-7",
        "template_id": "approved-tts-realtime-v7"
      },
      "quarantine_reason": null
    }
  ]
}
