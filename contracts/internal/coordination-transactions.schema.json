        },
        "deletion_evidence_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        }
      },
      "description": "Trusted deletion coordinator permit only; verify the authoritative deletion job/dependency scope before calling. Clear private command content only after execution cleanup and lease release. Preserve identities, request/command digests, fencing, stop facts and an immutable deletion tombstone. Replays use deletion_job_id and evidence digest; never authorize re-execution."
    }
  }
