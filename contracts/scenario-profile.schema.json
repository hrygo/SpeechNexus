{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/scenario-profile.schema.json",
  "title": "ScenarioProfileRevision",
  "description": "Immutable scenario preset revision. A profile composes explicit ASR/TTS policy parameters with capability requirements, validation evidence, and publication lifecycle metadata. It never carries scheduling priority, engine endpoints, model paths, credentials, or user identity.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profile_id": {
      "$ref": "#/$defs/Identifier",
      "description": "Stable profile family identifier. The pair (profile_id, revision) is immutable."
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "published_at",
        "retired_at",
        "disabled_reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "retired",
            "disabled"
          ]
        },
        "published_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retired_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "disabled_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "validation": {
      "$ref": "#/$defs/ProfileValidation"
    },
    "supersedes_revision": {
      "oneOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/ProfileDefinition"
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "draft"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "published_at": {
                "type": "null"
              },
              "retired_at": {
                "type": "null"
              },
              "disabled_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "published_at"
            ],
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "retired_at": {
                "type": "null"
              },
              "disabled_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "retired"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "published_at",
              "retired_at"
            ],
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "retired_at": {
                "type": "string",
                "format": "date-time"
              },
              "disabled_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "disabled"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "published_at",
              "disabled_reason"
            ],
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "retired_at": {
                "type": "null"
              },
              "disabled_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "not": {
                  "const": "draft"
                }
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "required": [
          "validation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "asr"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "required": [
              "asr"
            ],
            "not": {
              "required": [
                "tts"
              ]
            },
            "properties": {
              "output": {
                "not": {
                  "required": [
                    "audio_format"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tts"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "required": [
              "tts"
            ],
            "not": {
              "required": [
                "asr"
              ]
            },
            "properties": {
              "output": {
                "not": {
                  "required": [
                    "transcript_format"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "duplex"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "required": [
              "asr",
              "tts"
            ]
          },
          "execution_classes": {
            "contains": {
              "const": "realtime"
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_tier": {
            "const": "production"
          }
        },
        "required": [
          "release_tier"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "const": "production"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ProfileDefinition": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "enum": [
            "asr",
            "tts",
            "duplex"
          ],
          "description": "duplex profiles are valid only for realtime sessions that reserve both ASR and TTS resources atomically."
        },
        "release_tier": {
          "$ref": "#/$defs/ProfileReleaseTier"
        },
        "execution_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ExecutionClass"
          }
        },
        "parameters": {
          "$ref": "#/$defs/ProfileParameters"
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "description": "Capability requirements. Capability names are unique within a profile revision; producer validation rejects the same capability appearing twice with different constraints.",
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          }
        },
        "override_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ParameterPath"
          },
          "description": "Only these paths may be overridden by a request. Omitted paths are not overridable even when the value is within a declared range."
        },
        "override_ranges": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ParameterPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/OverrideRange"
          },
          "description": "Allowed override ranges or enum domains. Keys must be a subset of override_allowlist; a range for a non-overridable path is a configuration error. An allowlisted path without an entry is bounded only by ProfileParameters and the binding domain. Producer validation requires minimum <= maximum when both are present."
        },
        "slo_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Reference to the deployment SLO document or qualification report scenario. It is not a numeric promise in this schema."
        }
      },
      "required": [
        "display_name",
        "kind",
        "release_tier",
        "execution_classes",
        "parameters",
        "required_capabilities",
        "override_allowlist",
        "override_ranges",
        "slo_ref"
      ]
    },
    "Identifier": {
      "$ref": "shared/identifiers.schema.json#/$defs/Identifier"
    },
    "Revision": {
      "$ref": "shared/identifiers.schema.json#/$defs/Revision"
    },
    "Sha256Digest": {
      "$ref": "shared/identifiers.schema.json#/$defs/Sha256Digest"
    },
    "ProfileReleaseTier": {
      "$ref": "shared/capability-domains.schema.json#/$defs/ProfileReleaseTier"
    },
    "ExecutionClass": {
      "$ref": "shared/capability-domains.schema.json#/$defs/ServiceClass"
    },
    "ParameterPath": {
      "type": "string",
      "enum": [
        "asr.language",
        "asr.preview_interval_ms",
        "asr.max_segment_ms",
        "asr.finalization",
        "asr.final_deadline_ms",
        "asr.auxiliary_deadline_ms",
        "asr.rollback_tokens",
        "asr.turn_detection.mode",
        "asr.turn_detection.silence_duration_ms",
        "asr.vocabulary_set_revision",
        "asr.alignment",
        "asr.diarization",
        "tts.language",
        "tts.text_commit_mode",
        "tts.audio_delivery",
        "tts.speed",
        "tts.instructions",
        "tts.pronunciation_revision",
        "tts.seed",
        "tts.planner.max_chars",
        "tts.planner.max_wait_ms",
        "output.transcript_format",
        "output.audio_format",
        "output.save_artifacts"
      ]
    },
    "OverrideRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "minimum"
          ]
        },
        {
          "required": [
            "maximum"
          ]
        },
        {
          "required": [
            "enum"
          ]
        }
      ]
    },
    "AsrParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "preview_interval_ms",
        "max_segment_ms",
        "finalization",
        "final_deadline_ms",
        "auxiliary_deadline_ms",
        "rollback_tokens",
        "turn_detection",
        "alignment",
        "diarization"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "preview_interval_ms": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrPreviewIntervalMs"
        },
        "max_segment_ms": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrMaxSegmentMs"
        },
        "finalization": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrFinalization"
        },
        "final_deadline_ms": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrFinalDeadlineMs"
        },
        "auxiliary_deadline_ms": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrAuxiliaryDeadlineMs"
        },
        "rollback_tokens": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrRollbackTokens"
        },
        "turn_detection": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrTurnDetection"
        },
        "vocabulary_set_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/ResourceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "alignment": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrAlignment"
        },
        "diarization": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrDiarization"
        }
      }
    },
    "TtsParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text_commit_mode",
        "audio_delivery",
        "speed",
        "planner"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "text_commit_mode": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsTextCommitMode"
        },
        "audio_delivery": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsAudioDelivery"
        },
        "speed": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsSpeed"
        },
        "instructions": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsInstructions"
        },
        "pronunciation_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/ResourceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsSeed"
        },
        "planner": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsPlanner"
        }
      }
    },
    "OutputParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcript_format": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/OutputTranscriptFormat"
        },
        "audio_format": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/OutputAudioFormat"
        },
        "save_artifacts": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/OutputSaveArtifacts"
        }
      }
    },
    "ProfileParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": {
          "$ref": "#/$defs/AsrParameters"
        },
        "tts": {
          "$ref": "#/$defs/TtsParameters"
        },
        "output": {
          "$ref": "#/$defs/OutputParameters"
        }
      }
    },
    "CapabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "required"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^(asr|tts|voice|audio)\\.[a-z0-9_.-]{2,64}$"
        },
        "required": {
          "type": "boolean"
        },
        "constraint": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "minimum"
              ]
            },
            {
              "required": [
                "maximum"
              ]
            },
            {
              "required": [
                "enum"
              ]
            }
          ]
        }
      }
    },
    "ProfileValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "revision",
        "validation_report_id",
        "validated_at",
        "status",
        "evidence_digest"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "validation_report_id": {
          "$ref": "#/$defs/Identifier"
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "production"
          ]
        },
        "evidence_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "corpus_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "LanguageTag": {
      "$ref": "shared/language.schema.json#/$defs/LanguageTag"
    },
    "ResourceReference": {
      "$ref": "shared/references.schema.json#/$defs/ResourceReference"
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "profile_id": "caption-live",
      "revision": "1",
      "display_name": "Live captions",
      "kind": "asr",
      "release_tier": "experimental",
      "execution_classes": [
        "realtime"
      ],
      "parameters": {
        "asr": {
          "language": "zh",
          "preview_interval_ms": 500,
          "max_segment_ms": 8000,
          "finalization": "full_segment",
          "final_deadline_ms": 2000,
          "auxiliary_deadline_ms": 5000,
          "rollback_tokens": 5,
          "turn_detection": {
            "mode": "server_vad",
            "silence_duration_ms": 400
          },
          "vocabulary_set_revision": null,
          "alignment": "off",
          "diarization": "off"
        },
        "output": {
          "transcript_format": "json",
          "save_artifacts": false
        }
      },
      "required_capabilities": [
        {
          "capability": "asr.streaming_preview",
          "required": true
        },
        {
          "capability": "asr.full_segment_review",
          "required": true
        }
      ],
      "override_allowlist": [
        "asr.language",
        "asr.preview_interval_ms"
      ],
      "override_ranges": {
        "asr.preview_interval_ms": {
          "minimum": 300,
          "maximum": 1000
        }
      },
      "slo_ref": "slo/realtime-caption-v1",
      "validation": {
        "profile_id": "caption-live",
        "revision": "1",
        "validation_report_id": "profileval-caption-live-1",
        "validated_at": "2026-10-22T09:00:00Z",
        "status": "experimental",
        "evidence_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "publication": {
        "status": "published",
        "published_at": "2026-10-22T09:00:00Z",
        "retired_at": null,
        "disabled_reason": null
      }
    },
    {
      "schema_version": "1.0.0",
      "profile_id": "audiobook-consistent",
      "revision": "1",
      "display_name": "Audiobook consistent narration",
      "kind": "tts",
      "release_tier": "experimental",
      "execution_classes": [
        "batch"
      ],
      "parameters": {
        "tts": {
          "language": "zh",
          "text_commit_mode": "explicit",
          "audio_delivery": "complete",
          "speed": 1.0,
          "instructions": null,
          "pronunciation_revision": null,
          "seed": null,
          "planner": {
            "max_chars": 400,
            "max_wait_ms": 3000
          }
        },
        "output": {
          "audio_format": "wav",
          "save_artifacts": true
        }
      },
      "required_capabilities": [
        {
          "capability": "tts.reusable_voice",
          "required": true
        },
        {
          "capability": "audio.wav_encode",
          "required": true
        }
      ],
      "override_allowlist": [
        "tts.speed",
        "tts.pronunciation_revision"
      ],
      "override_ranges": {
        "tts.speed": {
          "minimum": 0.8,
          "maximum": 1.2
        }
      },
      "slo_ref": "slo/batch-audiobook-v1",
      "validation": {
        "profile_id": "audiobook-consistent",
        "revision": "1",
        "validation_report_id": "profileval-audiobook-1",
        "validated_at": "2026-10-22T09:00:00Z",
        "status": "experimental",
        "evidence_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "publication": {
        "status": "published",
        "published_at": "2026-10-22T09:00:00Z",
        "retired_at": null,
        "disabled_reason": null
      }
    },
    {
      "schema_version": "1.0.0",
      "profile_id": "assistant-duplex",
      "revision": "1",
      "display_name": "Assistant duplex",
      "kind": "duplex",
      "release_tier": "experimental",
      "execution_classes": [
        "realtime"
      ],
      "parameters": {
        "asr": {
          "language": "zh",
          "preview_interval_ms": 600,
          "max_segment_ms": 20000,
          "finalization": "full_segment",
          "final_deadline_ms": 2000,
          "auxiliary_deadline_ms": 5000,
          "rollback_tokens": 5,
          "turn_detection": {
            "mode": "server_vad",
            "silence_duration_ms": 900
          },
          "vocabulary_set_revision": null,
          "alignment": "off",
          "diarization": "off"
        },
        "tts": {
          "language": "zh",
          "text_commit_mode": "explicit",
          "audio_delivery": "chunked",
          "speed": 1.0,
          "instructions": null,
          "pronunciation_revision": null,
          "seed": null,
          "planner": {
            "max_chars": 120,
            "max_wait_ms": 800
          }
        },
        "output": {
          "audio_format": "pcm",
          "save_artifacts": false
        }
      },
      "required_capabilities": [
        {
