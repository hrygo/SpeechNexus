{
  "openapi": "3.1.0",
  "info": {
    "title": "SpeechNexus public speech API",
    "version": "0.1.0.dev14",
    "description": "SpeechNexus public speech protocol.\n\nThe OpenAI-compatible subset is limited to the paths, fields, formats, and\nevents explicitly declared here. A standard OpenAI SDK can use this API by\nsetting base_url to <deployment>/v1 and supplying any api_key value unless\nthe deployment enables a shared service key. SpeechNexus enhancements live\nunder /v1/nexus and the optional `nexus` request field; a standard request\nnever needs an enhancement wrapper. Unsupported standard parameters are\nrejected with 422 `unsupported_parameter`, never silently ignored.\n\nRealtime has two connection modes at GET /v1/realtime: a pre-created\nnexus session (`session_id`) and a compatibility transcription session\nopened with `model`. Both accept the declared standard transcription\nevent subset. TTS, previews, metadata, and operation coordination remain\nnexus.* events and are available only in a nexus-created session.\n"
  },
  "security": [
    {
      "SharedServiceKey": []
    },
    {}
  ],
  "paths": {
    "/v1/nexus/pronunciation-sets": {
      "get": {
        "tags": ["voices"],
        "operationId": "listPronunciationSets",
        "summary": "List pronunciation sets",
        "description": "Lists family heads by ascending opaque `id`. The cursor is the canonical\nunpadded base64 form of the last returned id; a cursor that does not\nre-encode to the same bytes is rejected rather than silently moving the\npage. `limit` is 1-100 and defaults to 50. `has_more` is true only when a\nfurther page exists, and `next_cursor` is then that page's opaque cursor.\n\nEvery returned `status` is `draft`: this deployment only stores immutable\ndraft revisions, so a listed head never claims publication, execution or\nTTS qualification. An empty collection is a successful 200 with no\nentries, never a 404.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Pronunciation-set heads.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PronunciationList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PronunciationInvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PronunciationCollectionForbidden"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/PronunciationContractViolation"
          },
          "503": {
            "description": "Draft storage is unavailable. A list read carries no body and may be repeated; this is a retryable outage, not a permanently unimplemented operation.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Should-Retry": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "true"
                }
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "pronunciation_unavailable"
                            },
                            "type": {
                              "const": "service_unavailable_error"
                            },
                            "retryable": {
                              "const": true
                            },
                            "nexus": false
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["voices"],
        "operationId": "createPronunciationRevision",
        "summary": "Create an immutable pronunciation-set revision",
        "description": "Omit `id` to create a new pronunciation set. Supply `id` and\n`expected_revision` to append a revision to an existing set. Entries are\nvalidated and stored as an immutable **draft** revision; an existing\nrevision is never modified and this operation never publishes, selects a\ndefault, executes TTS or qualifies pronunciation.\n\n`publish` defaults to `false` and describes draft creation only. A\n`publish: true` request is not supported by this operation and returns\n422 `pronunciation_publication_not_supported`; publication has its own\ncommand. The returned `status` is always `draft`.\n\nWith an `Idempotency-Key`, the same canonical intent replays the original\nrevision and a different intent returns 409\n`pronunciation_idempotency_conflict`. Without a key, a submission whose\ncommit cannot be confirmed returns 409 `pronunciation_outcome_unknown`\nbecause a resubmission would be a new intent. An append whose\n`expected_revision` is not the current allocation head returns 409\n`pronunciation_configuration_changed`.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PronunciationCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable pronunciation draft revision created or replayed.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/External_voice_resource_schema_json_PronunciationRevision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PronunciationInvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PronunciationCollectionForbidden"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/PronunciationSetConflict"
          },
          "422": {
            "$ref": "#/components/responses/PronunciationPublicationNotSupported"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/PronunciationContractViolation"
          },
          "503": {
            "description": "Draft storage is unavailable. Only a request that carries its original Idempotency-Key may be retried unchanged: replaying that key recovers the committed revision instead of allocating a second one. This is a retryable outage, not a permanently unimplemented operation.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Should-Retry": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "true"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "pronunciation_unavailable"
                            },
                            "type": {
                              "const": "service_unavailable_error"
                            },
                            "retryable": {
                              "const": true
                            },
                            "nexus": false
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "XRequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "description": "Optional idempotency key. The scope is (deployment_id, workspace_id,\noperation_family, key). Standard OpenAI clients may omit it.\n"
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Validated client request ID or a server-generated correlation ID.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying a capacity or cancellation coordination request.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemas": {
      "PronunciationList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "data", "has_more", "next_cursor"],
        "properties": {
          "object": {
            "const": "nexus.list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PronunciationSummary"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": ["string", "null"]
          }
        }
      },
      "PronunciationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "head_revision", "encoding", "entry_count", "status"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "head_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "encoding": {
            "type": "string",
            "enum": ["pinyin", "ipa"]
          },
          "entry_count": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "retired"]
          }
        }
      },
      "Identifier": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
      },
      "External_shared_identifiers_schema_json_Identifier": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
        "minLength": 3,
        "maxLength": 128,
        "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
      },
      "Revision": {
        "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
      },
      "External_shared_identifiers_schema_json_Revision": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$",
        "maxLength": 19,
        "description": "Monotonic decimal revision represented as a string."
      },
      "ErrorResponse": {
        "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorResponse"
      },
      "External_shared_errors_schema_json_ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorBody"
          }
        }
      },
      "External_shared_errors_schema_json_ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "type", "message", "param", "request_id", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "description": "Stable machine-readable error code."
          },
          "type": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_ErrorType"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "param": {
            "type": ["string", "null"],
            "maxLength": 128
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_ms": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "nexus": {
            "$ref": "#/components/schemas/External_shared_errors_schema_json_OperationRecovery"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "enum": ["operation_in_progress", "response_not_replayable"]
                }
              }
            },
            "then": {
              "required": ["nexus"]
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "response_not_replayable"
                }
              }
            },
            "then": {
              "properties": {
                "nexus": {
                  "required": ["receipt"]
                }
              }
            }
          }
        ]
      },
      "External_shared_errors_schema_json_ErrorType": {
        "type": "string",
        "enum": [
          "invalid_request_error",
          "authentication_error",
          "permission_error",
          "not_found_error",
          "rate_limit_error",
          "api_error",
          "service_unavailable_error"
        ]
      },
      "External_shared_errors_schema_json_OperationRecovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id"],
        "properties": {
          "operation_id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "receipt": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_ExecutionReceipt"
          }
        },
        "description": "Query GET /v1/nexus/operations/{operation_id}. This identity is the original execution; retrying never creates a second execution."
      },
      "External_shared_receipts_schema_json_ExecutionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "requested", "effective", "observed", "missing", "unknown"],
        "properties": {
          "receipt_id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "request_id": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 128
          },
          "requested": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "effective": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "observed": {
            "$ref": "#/components/schemas/External_shared_receipts_schema_json_PublicExecutionFacts"
          },
          "missing": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_receipts_schema_json_ReceiptFactPath"
            }
          },
          "unknown": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/External_shared_receipts_schema_json_ReceiptFactPath"
            }
          }
        }
      },
      "External_shared_receipts_schema_json_PublicExecutionFacts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "$ref": "#/components/schemas/External_shared_language_schema_json_LanguageTag"
          },
          "seed": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_seed"
          },
          "speed": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_speed"
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "maximum": 384000
          },
          "response_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AudioFormat"
              },
              {
                "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_TranscriptFormat"
              }
            ]
          },
          "max_segment_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_max_segment_ms"
          },
          "model_binding": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "profile": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "voice": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "pronunciation": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "turn_detection": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_turn_detection"
          },
          "finalization": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_finalization"
          },
          "preview_interval_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_preview_interval_ms"
          },
          "rollback_tokens": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_rollback_tokens"
          },
          "final_deadline_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_final_deadline_ms"
          },
          "auxiliary_deadline_ms": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_auxiliary_deadline_ms"
          },
          "alignment": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_alignment"
          },
          "diarization": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_diarization"
          },
          "vocabulary_set_revision": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_vocabulary_set_revision"
          },
          "text_commit_mode": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_text_commit_mode"
          },
          "audio_delivery": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_audio_delivery"
          },
          "pronunciation_revision": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_pronunciation_revision"
          },
          "planner": {
            "$ref": "#/components/schemas/External_shared_speech_overrides_schema_json_planner"
          },
          "instructions_present": {
            "type": "boolean"
          },
          "prompt_present": {
            "type": "boolean"
          },
          "policy": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          },
          "vocabulary": {
            "$ref": "#/components/schemas/External_shared_references_schema_json_ResourceReference"
          }
        },
        "description": "Allowlisted public projection only. Omit content, prompt, instructions, vendor payloads and private runtime identities. Unknown facts go into stable missing/unknown paths, never arbitrary dictionaries."
      },
      "External_shared_language_schema_json_LanguageTag": {
        "type": "string",
        "pattern": "^(auto|[a-z]{2,3}(-[A-Za-z0-9]{2,8})*)$",
        "maxLength": 35
      },
      "External_shared_speech_overrides_schema_json_seed": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 2147483647
      },
      "External_shared_speech_overrides_schema_json_speed": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 4.0
      },
      "External_shared_capability_domains_schema_json_AudioFormat": {
        "type": "string",
        "enum": ["mp3", "wav", "pcm"]
      },
      "External_shared_capability_domains_schema_json_TranscriptFormat": {
        "type": "string",
        "enum": ["json", "text", "verbose_json", "srt", "vtt"]
      },
      "External_shared_speech_overrides_schema_json_max_segment_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000
      },
      "External_shared_references_schema_json_ResourceReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Identifier"
          },
          "revision": {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
          }
        }
      },
      "External_shared_speech_overrides_schema_json_turn_detection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_VadMode"
          },
          "silence_duration_ms": {
            "type": "integer",
            "minimum": 200,
            "maximum": 3000
          }
        }
      },
      "External_shared_capability_domains_schema_json_VadMode": {
        "type": "string",
        "enum": ["server_vad", "manual"]
      },
      "External_shared_speech_overrides_schema_json_finalization": {
        "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_FinalizationMode"
      },
      "External_shared_capability_domains_schema_json_FinalizationMode": {
        "type": "string",
        "enum": ["full_segment", "streaming_finalize"]
      },
      "External_shared_speech_overrides_schema_json_preview_interval_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 5000
      },
      "External_shared_speech_overrides_schema_json_rollback_tokens": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32
      },
      "External_shared_speech_overrides_schema_json_final_deadline_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 10000
      },
      "External_shared_speech_overrides_schema_json_auxiliary_deadline_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 10000
      },
      "External_shared_speech_overrides_schema_json_alignment": {
        "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AuxiliaryMode"
      },
      "External_shared_capability_domains_schema_json_AuxiliaryMode": {
        "type": "string",
        "enum": ["off", "required", "best_effort"]
      },
      "External_shared_speech_overrides_schema_json_diarization": {
        "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AuxiliaryMode"
      },
      "External_shared_speech_overrides_schema_json_vocabulary_set_revision": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
          },
          {
            "type": "null"
          }
        ]
      },
      "External_shared_speech_overrides_schema_json_text_commit_mode": {
        "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_TextCommitMode"
      },
      "External_shared_capability_domains_schema_json_TextCommitMode": {
        "type": "string",
        "enum": ["explicit", "sentence"]
      },
      "External_shared_speech_overrides_schema_json_audio_delivery": {
        "$ref": "#/components/schemas/External_shared_capability_domains_schema_json_AudioDeliveryMode"
      },
      "External_shared_capability_domains_schema_json_AudioDeliveryMode": {
        "type": "string",
        "enum": ["complete", "chunked"]
      },
      "External_shared_speech_overrides_schema_json_pronunciation_revision": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/External_shared_identifiers_schema_json_Revision"
          },
          {
            "type": "null"
          }
        ]
      },
      "External_shared_speech_overrides_schema_json_planner": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_chars": {
            "type": "integer",
            "minimum": 40,
            "maximum": 400
          },
          "max_wait_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3000
          }
