{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuiltinVoiceQualificationContracts",
  "x-nexus-bindings-version": "1.0.0",
  "x-nexus-entrypoints": ["BuiltinVoiceQualificationAuthorization"],
  "$defs": {
    "Root": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BuiltinVoiceQualificationAuthorization",
      "description": "Private, single-use authorization for one bounded diagnostic execution. This is not voice publication or runtime qualification; the independent result producer must verify physical evidence before granting qualification.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "authorization_id",
        "source_approval_id",
        "voice_id",
        "voice_revision",
        "voice_revision_id",
        "native_speaker_id",
        "binding_id",
        "binding_revision_id",
        "manifest_id",
        "policy_revision_id",
        "host_node_id",
        "gateway_id",
        "instance_id",
        "instance_generation",
        "operation_id",
        "attempt_id",
        "command_digest",
        "expires_at_us",
        "manifest_digest",
        "report_id",
        "report_digest",
        "model_artifact_digest",
        "image_digest",
        "template_id",
        "template_config_digest",
        "template_digest",
        "controller_artifact_digest",
        "controller_revision",
        "native_authority",
        "gateway_request_digest",
        "admission_request_digest",
        "business_request_digest",
        "database",
        "schema",
        "installation_id"
      ],
      "properties": {
        "purpose": {
          "const": "builtin_voice_qualification"
        },
        "authorization_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "source_approval_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "voice_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "voice_revision": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
        },
        "voice_revision_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "native_speaker_id": {
          "const": "Vivian"
        },
        "binding_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "binding_revision_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "manifest_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "policy_revision_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "host_node_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "gateway_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "instance_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "instance_generation": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "attempt_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "command_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "expires_at_us": {
          "type": "integer",
          "minimum": 1,
          "description": "UTC Unix microseconds; new admission must occur before this time."
        },
        "manifest_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "report_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "report_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "model_artifact_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "image_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "template_id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "template_config_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "template_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "controller_artifact_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "controller_revision": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "native_authority": {
          "const": true
        },
        "gateway_request_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "admission_request_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "business_request_digest": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "installation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "External_shared_identifiers_schema_json_Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
    },
    "External_shared_identifiers_schema_json_Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "maxLength": 19,
      "description": "Monotonic decimal revision represented as a string."
    },
    "External_shared_identifiers_schema_json_Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "BuiltinVoiceQualificationAuthorization": {
      "$ref": "#/$defs/Root"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/BuiltinVoiceQualificationAuthorization"
    }
  ]
}
