          }
        },
        {
          "direction": "server",
          "value": {
            "type": "conversation.item.input_audio_transcription.completed",
            "event_id": "event-completed-demo",
            "item_id": "item-demo",
            "content_index": 0,
            "transcript": "Synthetic transcript.",
            "usage": {
              "type": "duration",
              "seconds": 0.1
