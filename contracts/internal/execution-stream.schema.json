      "type": "stream.closed",
      "stream_id": "stream_demo",
      "stream_epoch": 1,
      "seq": 9,
      "sent_at": "2026-10-22T09:01:00Z",
      "operation_id": "op_demo",
      "submit_intent_id": "submit_demo",
      "status": "succeeded",
      "cleanup_state": "complete",
      "input_watermark": 24000,
      "output_watermark": 24000,
      "receipt_ref": "rcpt_demo",
      "error": null
    }
  ],
  "unevaluatedProperties": false
}
