# Local Compose bootstrap only. Never use these values for a real deployment.
POSTGRES_USER=speechnexus
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=speechnexus
MINIO_ROOT_USER=speechnexus
MINIO_ROOT_PASSWORD=change-me-local-minio
SPEECHNEXUS_NODE_ID=node-local-1
# Asset default retention: 7 days, in seconds; explicit upload TTL takes precedence.
SPEECHNEXUS_ASSET_DEFAULT_TTL_SECONDS=604800
# Optional profile drafts: separate non-owner role, pre-applied 0009 + explicit grants.
# Blank keeps the writer disabled; never copy the bootstrap owner URL here.
SPEECHNEXUS_PROFILE_WRITER_DATABASE_URL=
# Choose at most one binding mode; both blank disables either writer.
# Legacy mode: separately provisioned three-table non-owner role.
SPEECHNEXUS_BINDING_WRITER_DATABASE_URL=
# Producer mode: pre-applied 0011 and separately provisioned four-table minimum role.
# Never put the bootstrap owner URL here; startup only verifies permissions.
SPEECHNEXUS_BINDING_DEFAULTS_WRITER_DATABASE_URL=
