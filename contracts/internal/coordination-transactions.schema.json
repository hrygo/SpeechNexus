{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/internal/coordination-transactions.schema.json",
  "title": "ControlledCoordinationTransactions",
  "description": "ADR 0006 internal application transaction ports, not HTTP routes and not a production implementation. Validate wire shape and format before semantic validation and locks. Reuse existing execution/runtime protocol definitions. See coordination-transactions.md for atomicity, lock order, replay identity, error mapping and unknown commit recovery. Integers and products must fit signed BIGINT; decimal revisions above that limit are rejected before SQL. Canonical request digests use RFC 8785 SHA-256 over the validated request, without the result or transport metadata. JSON numeric inputs are bounded to 2^53-1 for exact RFC 8785 canonicalization; arithmetic intermediates and decimal revisions must fit signed BIGINT. Reject exhaustion; never wrap. The document root accepts both command envelopes and TransactionResult envelopes; result.operation selects its typed value.",
  "x-speechnexus-schema-version": "1.0.0",
