            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "mode": {
              "type": "string",
              "enum": [
                "drain",
                "abort"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "client_close",
                "session_end",
                "deadline",
                "cancel",
                "error"
              ]
            }
          }
        }
      ]
    },
    "StreamClosed": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "type",
            "stream_id",
            "stream_epoch",
            "seq",
            "sent_at",
            "operation_id",
            "submit_intent_id",
            "status",
            "cleanup_state",
            "input_watermark",
            "output_watermark"
          ],
          "properties": {
            "schema_version": {
              "const": "1.1.0"
            },
            "type": {
              "const": "stream.closed"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "submit_intent_id": {
              "$ref": "#/$defs/Identifier"
            },
            "status": {
              "$ref": "#/$defs/TerminalOperationStatus"
            },
            "cleanup_state": {
              "$ref": "#/$defs/CleanupState"
            },
            "input_watermark": {
              "type": "integer",
              "minimum": 0,
              "description": "Cumulative accepted input sample position for stream transport. Authoritative input usage remains the canonical interval ledger."
            },
            "output_watermark": {
              "type": "integer",
              "minimum": 0,
              "description": "Cumulative emitted output sample position for stream transport. Authoritative output usage remains output_sample_intervals; this scalar is not an independent meter."
            },
            "receipt_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "oneOf": [
                {
                  "$ref": "#/$defs/StreamError"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "cancelled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "receipt_ref"
            ],
            "properties": {
              "receipt_ref": {
                "not": {
                  "type": "null"
                }
              },
              "cleanup_state": {
                "const": "complete"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "cleanup_state": {
                "enum": [
                  "not_required",
                  "complete"
                ]
              }
            }
          }
        }
      ]
    },
