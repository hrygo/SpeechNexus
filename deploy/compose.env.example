# Local Compose bootstrap only. Never use these values for a real deployment.
POSTGRES_USER=speechnexus
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=speechnexus
MINIO_ROOT_USER=speechnexus
MINIO_ROOT_PASSWORD=change-me-local-minio

# Runtime DSNs are explicit: the API and gateway must not inherit the migration
# owner. Provision separate API, gateway-writer and gateway-query roles. The
# registration DSN is used only by the opt-in one-shot registration profile.
# Migration/registration use the bootstrap owner in this local example; both
# must be replaced by separately provisioned operator identities in deployment.
SPEECHNEXUS_API_DATABASE_URL=postgresql://sn_api:change-me-api-role@postgres:5432/speechnexus
SPEECHNEXUS_GATEWAY_CONTROL_DATABASE_URL=postgresql://sn_gateway:change-me-gateway-role@postgres:5432/speechnexus
SPEECHNEXUS_GATEWAY_CONTROL_QUERY_DATABASE_URL=postgresql://sn_gateway_query:change-me-gateway-query-role@postgres:5432/speechnexus
SPEECHNEXUS_REGISTRATION_DATABASE_URL=postgresql://speechnexus:change-me-local-postgres@postgres:5432/speechnexus
SPEECHNEXUS_MIGRATION_DATABASE_URL=postgresql://speechnexus:change-me-local-postgres@postgres:5432/speechnexus

# Host-side inputs for the role-provisioning snippet in the minimal runbook.
# They are not passed to the API or gateway containers.
SPEECHNEXUS_API_ROLE_PASSWORD=change-me-api-role
SPEECHNEXUS_GATEWAY_ROLE_PASSWORD=change-me-gateway-role
SPEECHNEXUS_GATEWAY_QUERY_ROLE_PASSWORD=change-me-gateway-query-role

# The API and gateway run as this non-root host UID/GID so private files remain
# owner-only without copying credentials into an image. On macOS/Linux set these
# from `id -u` and `id -g`; do not use 0.
SPEECHNEXUS_RUNTIME_UID=10001
SPEECHNEXUS_RUNTIME_GID=10001

# Loopback-only host port mappings. Change them when another local service has
# already claimed a default port; container-to-container addresses do not change.
SPEECHNEXUS_POSTGRES_HOST_PORT=55432
SPEECHNEXUS_MINIO_S3_HOST_PORT=59000
SPEECHNEXUS_MINIO_CONSOLE_HOST_PORT=59001
SPEECHNEXUS_API_HOST_PORT=8000
SPEECHNEXUS_GATEWAY_HOST_PORT=8010
SPEECHNEXUS_ADMIN_HOST_PORT=8080
SPEECHNEXUS_WORKBENCH_HOST_PORT=8081

# Runtime identities. Keep the registration identity and generation fixed so a
# re-run is idempotent instead of creating a new generation.
SPEECHNEXUS_NODE_ID=node-local-1
SPEECHNEXUS_GATEWAY_ID=gateway-1
SPEECHNEXUS_ENGINE_INSTANCE_ID=instance-asr-1
SPEECHNEXUS_ENGINE_GENERATION=1
SPEECHNEXUS_ENGINE_HEALTH_URL=http://host.docker.internal:18100
SPEECHNEXUS_ADMISSION_WORKSPACE=workspace-default
SPEECHNEXUS_ADMISSION_MAX_ATTEMPTS=8

# Private deployment files and writable gateway scratch paths. They are ignored
# by git under deploy/.runtime; copy the .example JSON files and replace all
# synthetic identities, digests, buckets, endpoints and credentials.
SPEECHNEXUS_PRIVATE_CONFIG_DIR=./.runtime/private
SPEECHNEXUS_GATEWAY_LOCK_DIR=./.runtime/gateway-locks
SPEECHNEXUS_GATEWAY_SPOOL_DIR=./.runtime/gateway-spool

# Shared component credential for API -> gateway control calls. This is a
# reference only; generate a fresh value outside the repository.
SPEECHNEXUS_EXECUTION_GATEWAY_COMPONENT_CREDENTIAL=change-me-component-credential

# Private object buckets. minio-init creates both and enables versioning.
SPEECHNEXUS_OBJECT_STORAGE_BUCKET=speechnexus-results
SPEECHNEXUS_TRANSCRIPTION_INPUT_BUCKET=speechnexus-inputs
# Gateway staging results are read back by the opt-in Job dispatcher. It must be a
# bucket minio-init versions, and must match the private gateway configs'
# `result_bucket`; the reference deployment uses the Artifact bucket for both.
SPEECHNEXUS_EXECUTION_RESULT_BUCKET=speechnexus-results

# Bounded synchronous ASR limits. These are deployment ceilings, not model
# qualification or capacity evidence.
SPEECHNEXUS_TRANSCRIPTION_POLL_SECONDS=0.25
SPEECHNEXUS_TRANSCRIPTION_MAX_AUDIO_MS=120000
SPEECHNEXUS_TRANSCRIPTION_MAX_UPLOAD_BYTES=26214400
SPEECHNEXUS_TRANSCRIPTION_TIMEOUT_SECONDS=120
SPEECHNEXUS_TRANSCRIPTION_MAX_COMMAND_BYTES=65536
SPEECHNEXUS_TRANSCRIPTION_STORAGE_TIMEOUT_SECONDS=3
SPEECHNEXUS_EXECUTION_GATEWAY_TIMEOUT_SECONDS=10

# Asset default retention: 7 days, in seconds; explicit upload TTL takes precedence.
SPEECHNEXUS_ASSET_DEFAULT_TTL_SECONDS=604800
# Optional profile drafts: separate non-owner role, pre-applied 0009 + explicit grants.
# Blank keeps the writer disabled; never copy the bootstrap owner URL here.
SPEECHNEXUS_PROFILE_WRITER_DATABASE_URL=
# Choose at most one binding mode; both blank disables either writer.
# Legacy mode: separately provisioned three-table non-owner role.
SPEECHNEXUS_BINDING_WRITER_DATABASE_URL=
# Producer mode: pre-applied 0011 and separately provisioned four-table minimum role.
# Never put the bootstrap owner URL here; startup only verifies permissions.
SPEECHNEXUS_BINDING_DEFAULTS_WRITER_DATABASE_URL=
# Read-only admin GET projection: SELECT on binding history, publications and
# binding publication evidence. Blank makes fixed binding GET return 503.
SPEECHNEXUS_BINDING_ADMIN_READER_DATABASE_URL=
# Explicit non-owner lifecycle writer (0023 + binding_lifecycle_grants).
# Blank keeps retire/activate fail-closed at 503.
SPEECHNEXUS_BINDING_LIFECYCLE_DATABASE_URL=
# Optional public Job writer: pre-applied 0017 and a non-owner role with INSERT on
# the two Job tables and the immutable submission table. Blank returns 503.
SPEECHNEXUS_JOB_WRITER_DATABASE_URL=
# Optional atomic admission role (public_job_admission_grants). Required for
# Post /v1/nexus/jobs; blank keeps reads/cancel working and returns 503 on create.
SPEECHNEXUS_JOB_ADMISSION_DATABASE_URL=
# Explicit non-owner voice publisher (voice_publication_grants, 0047). Separate
# from the Job writer; blank returns 503 on publication. Must share the writer DB.
SPEECHNEXUS_VOICE_PUBLISHER_DATABASE_URL=
# Pronunciation surfaces are independently provisioned non-owner roles:
#   reader    -> SELECT on the two fact tables and speech_publications
#   writer    -> pronunciation_draft_grants (draft revisions only)
#   publisher -> pronunciation_publication_grants (draft tables + ledger + head)
# All three are blank by default. With no publisher URL, publish: true answers
# 422 pronunciation_publication_not_supported while publish: false keeps working.
SPEECHNEXUS_PRONUNCIATION_READER_DATABASE_URL=
SPEECHNEXUS_PRONUNCIATION_WRITER_DATABASE_URL=
SPEECHNEXUS_PRONUNCIATION_PUBLISHER_DATABASE_URL=

# Optional binding-disable profile. These are distinct non-owner roles on the
# same PostgreSQL database; provision first using the minimal runbook. Blank
# values leave the base topology compatible and make the worker fail closed.
SPEECHNEXUS_DISABLE_DATABASE_URL=
SPEECHNEXUS_DISABLE_SETTLEMENT_DATABASE_URL=
SPEECHNEXUS_DISABLE_GATEWAY_TIMEOUT_SECONDS=10
SPEECHNEXUS_DISABLE_STORAGE_TIMEOUT_SECONDS=3
SPEECHNEXUS_DISABLE_POLL_SECONDS=1
SPEECHNEXUS_DISABLE_BATCH_SIZE=64
SPEECHNEXUS_DISABLE_WAIT_TIMEOUT_MS=1000

# Optional job-dispatch profile: the public Job dispatcher process. The DSN must
# name a non-owner worker role with the dispatch/planner/publication grants from
# docs/components/production-jobs.md; blank keeps the base topology working and
# makes the opt-in worker fail closed before it claims a lease. The worker shares
# the gateway network namespace, so its gateway origin stays on loopback.
SPEECHNEXUS_JOB_DISPATCH_DATABASE_URL=
SPEECHNEXUS_JOB_DISPATCH_INSTANCE_ID=dispatch-1
SPEECHNEXUS_JOB_DISPATCH_BATCH_SIZE=8
SPEECHNEXUS_JOB_DISPATCH_LEASE_MS=30000
SPEECHNEXUS_JOB_DISPATCH_POLL_SECONDS=1
SPEECHNEXUS_JOB_DISPATCH_JOB_TIMEOUT_SECONDS=600
SPEECHNEXUS_JOB_DISPATCH_MAX_ATTEMPTS=5
SPEECHNEXUS_JOB_DISPATCH_INTERVAL_SECONDS=5
SPEECHNEXUS_JOB_DISPATCH_STORAGE_TIMEOUT_SECONDS=3
# Comma-separated, de-duplicated dispatch lane. `asr,tts` is the in-process
# default; `voice_validation` additionally needs voice_validation_worker_grants.
SPEECHNEXUS_JOB_DISPATCH_KINDS=asr,tts

# Explicit Web proxy origins and Docker embedded DNS. Workbench API is not
# assembled here; replace this example with its approved address.
WEB_SPEECH_UPSTREAM=http://api:8000
WEB_WORKBENCH_UPSTREAM=http://workbench-api:8000
WEB_DNS_RESOLVER=127.0.0.11
