{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseEvidenceContracts",
  "x-nexus-bindings-version": "1.0.0",
  "x-nexus-entrypoints": ["QualificationReport", "CapacityManifest"],
  "$defs": {
    "Root": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "DeploymentQualificationReport",
      "description": "Evidence that a specific immutable binding, every execution-stage engine image and runtime, model artifact set, topology, and contract revision passed the declared scenarios. A production release tier requires at least one required scenario and every required scenario to pass. Optional scenario results are advisory and do not gate production; a non-passing optional result must be recorded in limitations. Producer validation must resolve the referenced binding and capacity manifest, verify binding and release identities, match every stage component exactly, and require qualified_at to precede expires_at. Scenario identifiers must exactly match test_suite.scenario_ids with no duplicates. JSON Schema enforces the shape while producer validation enforces these cross-document and cross-array rules.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "binding",
        "binding_revision_id",
        "capacity_manifest_id",
        "release_tier",
        "topology",
        "software",
        "test_suite",
        "scenarios",
        "required_scenarios_passed",
        "overall_status",
        "limitations",
        "evidence_digest",
        "qualified_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "report_id": {
          "$ref": "#/$defs/Identifier"
        },
        "binding": {
          "$ref": "#/$defs/BindingReference"
        },
        "binding_revision_id": {
          "$ref": "#/$defs/Identifier",
          "description": "Must equal ModelBindingRevision.revision_id and the capacity manifest binding_revision_id."
        },
        "capacity_manifest_id": {
          "$ref": "#/$defs/Identifier",
          "description": "Must equal CapacityManifest.manifest_id. The referenced manifest must carry the same binding_revision_id and release_tier as this report."
        },
        "release_tier": {
          "$ref": "#/$defs/ReleaseTier"
        },
        "topology": {
          "$ref": "#/$defs/Topology"
        },
        "software": {
          "$ref": "#/$defs/SoftwareSet"
        },
        "test_suite": {
          "$ref": "#/$defs/TestSuite"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "description": "One result per test_suite.scenario_id. Producer validation rejects missing or duplicate scenario evidence; a skipped result is evidence of non-qualification, not a pass.",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          }
        },
        "required_scenarios_passed": {
          "type": "boolean",
          "description": "Computed over scenarios with required=true: true exactly when at least one required scenario exists and every required scenario has status=passed. Optional results do not change this value."
        },
        "overall_status": {
          "type": "string",
          "enum": ["pass", "fail", "incomplete"],
          "description": "Computed over required scenarios only: fail when any required scenario failed; pass when required_scenarios_passed=true; otherwise incomplete. Optional results are advisory."
        },
        "limitations": {
          "type": "array",
          "description": "Qualification limitations. A skipped or failed optional scenario requires at least one recorded limitation because a non-passing optional result must not disappear from the release record.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidence_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "qualified_at": {
          "type": "string",
          "format": "date-time",
          "description": "Must be earlier than expires_at when expires_at is present."
        },
        "expires_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required_scenarios_passed": {
                "const": true
              }
            },
            "required": ["required_scenarios_passed"]
          },
          "then": {
            "properties": {
              "scenarios": {
                "contains": {
                  "type": "object",
                  "required": ["required"],
                  "properties": {
                    "required": {
                      "const": true
                    }
                  }
                },
                "minContains": 1,
                "items": {
                  "if": {
                    "properties": {
                      "required": {
                        "const": true
                      }
                    },
                    "required": ["required"]
                  },
                  "then": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    }
                  }
                }
              },
              "overall_status": {
                "const": "pass"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "overall_status": {
                "const": "pass"
              }
            },
            "required": ["overall_status"]
          },
          "then": {
            "properties": {
              "required_scenarios_passed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "overall_status": {
                "const": "fail"
              }
            },
            "required": ["overall_status"]
          },
          "then": {
            "properties": {
              "required_scenarios_passed": {
                "const": false
              },
              "scenarios": {
                "contains": {
                  "type": "object",
                  "required": ["required", "status"],
                  "properties": {
                    "required": {
                      "const": true
                    },
                    "status": {
                      "const": "failed"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "overall_status": {
                "const": "incomplete"
              }
            },
            "required": ["overall_status"]
          },
          "then": {
            "properties": {
              "required_scenarios_passed": {
                "const": false
              },
              "scenarios": {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["required", "status"],
                    "properties": {
                      "required": {
                        "const": true
                      },
                      "status": {
                        "const": "failed"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "release_tier": {
                "const": "production"
              }
            },
            "required": ["release_tier"]
          },
          "then": {
            "properties": {
              "required_scenarios_passed": {
                "const": true
              },
              "overall_status": {
                "const": "pass"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["expires_at"]
          }
        },
        {
          "if": {
            "properties": {
              "release_tier": {
                "const": "experimental"
              }
            },
            "required": ["release_tier"]
          },
          "then": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Identifier": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
    },
    "External_shared_identifiers_schema_json_Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
    },
    "BindingReference": {
      "$ref": "#/$defs/External_shared_references_schema_json_ResourceReference"
    },
    "External_shared_references_schema_json_ResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "revision": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
        }
      }
    },
    "External_shared_identifiers_schema_json_Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "maxLength": 19,
      "description": "Monotonic decimal revision represented as a string."
    },
    "ReleaseTier": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_ReleaseTier"
    },
    "External_shared_capability_domains_schema_json_ReleaseTier": {
      "type": "string",
      "enum": ["experimental", "best_effort", "production"]
    },
    "Topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_node_id",
        "cpu_arch",
        "hardware_class",
        "memory_architecture",
        "total_physical_memory_bytes"
      ],
      "properties": {
        "host_node_id": {
          "$ref": "#/$defs/Identifier"
        },
        "cpu_arch": {
          "type": "string",
          "enum": ["x86_64", "arm64"]
        },
        "hardware_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_architecture": {
          "$ref": "#/$defs/MemoryArchitecture"
        },
        "total_physical_memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "device_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "shared_memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parent_budget_id": {
              "$ref": "#/$defs/Identifier"
            },
            "shared_with_roles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["speech", "workbench_llm", "auxiliary"]
              }
            }
          }
        }
      }
    },
    "MemoryArchitecture": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_MemoryArchitecture"
    },
    "External_shared_capability_domains_schema_json_MemoryArchitecture": {
      "type": "string",
      "enum": ["unified_memory", "discrete_device_memory"],
      "description": "Unified memory shares one physical host/device pool; discrete memory accounts host RAM and device VRAM separately."
    },
    "SoftwareSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "contract_version", "engine_components"],
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "engine_components": {
          "type": "object",
          "minProperties": 1,
          "description": "Exact software identity for every execution stage in the referenced capacity manifest. Publication validation requires one component per stage_id and rejects conflicting or missing evidence.",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/EngineComponent"
          }
        }
      }
    },
    "EngineComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_kind", "image_digest", "runtime_version"],
      "properties": {
        "engine_kind": {
          "$ref": "#/$defs/EngineKind"
        },
        "image_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "EngineKind": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_EngineKind"
    },
    "External_shared_capability_domains_schema_json_EngineKind": {
      "type": "string",
      "enum": ["vllm", "vllm_omni", "nemo", "qwen_forced_aligner", "onnx_runtime", "cpu_native"]
    },
    "Sha256Digest": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
    },
    "External_shared_identifiers_schema_json_Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "TestSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "corpus_revision", "scenario_ids"],
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "corpus_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Revision": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
    },
    "ScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "required", "status", "evidence_digest"],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/Identifier"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          }
        },
        "evidence_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "s", "bytes", "percent", "ratio", "count", "cpms"]
        },
        "percentile": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "QualificationReport": {
      "$ref": "#/$defs/Root"
    },
    "External_capacity_manifest_schema_json_Root": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CapacityManifest",
      "description": "Hardware-neutral capacity, execution stage graph, loading peak, cancellation/fencing capability, and deployment qualification manifest bound to an immutable ModelBindingRevision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_id",
        "binding_revision_id",
        "pool_id",
        "service_class",
        "management_mode",
        "release_tier",
        "loading_policy",
        "topology_ref",
        "supported_tasks",
        "supported_input_formats",
        "supported_output_formats",
        "stage_graph",
        "resource_envelope",
        "rate_and_segment_limits",
        "cancellation_and_fencing",
        "qualification"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0",
          "description": "Frozen schema version for P0 capacity manifests."
        },
        "manifest_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Identifier",
          "description": "Immutable identifier for this capacity manifest."
        },
        "binding_revision_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Identifier",
          "description": "Must equal ModelBindingRevision.revision_id for the immutable binding revision governed by this manifest."
        },
        "pool_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_PoolId"
        },
        "service_class": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ServiceClass"
        },
        "management_mode": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ManagementMode"
        },
        "release_tier": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ReleaseTier"
        },
        "loading_policy": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_LoadingPolicy"
        },
        "topology_ref": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_TopologyReference"
        },
        "supported_tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_capacity_manifest_schema_json_SpeechTaskKind"
          }
        },
        "supported_input_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_capacity_manifest_schema_json_MediaFormat"
          }
        },
        "supported_output_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_capacity_manifest_schema_json_MediaFormat"
          }
        },
        "stage_graph": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/External_capacity_manifest_schema_json_StageResourceDeclaration"
          },
          "description": "Complete multi-stage execution recipe (including ASR 1.7B full_segment review, required alignment/diarization, or TTS Talker + Code2Wav + connector)."
        },
        "resource_envelope": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceEnvelope",
          "description": "Admission envelope derived from stage_graph. Memory/CPU/PCM/bandwidth/object-storage vectors are summed across stages; engine_active_slots is the per-execution slot cardinality (max stage value); max_active_slots is the minimum stage max_active_slots."
        },
        "rate_and_segment_limits": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_RateAndSegmentLimits"
        },
        "cancellation_and_fencing": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_CancellationAndFencingSpec"
        },
        "qualification": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_QualificationEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage_graph": {
                "contains": {
                  "type": "object",
                  "required": ["emits_audio_pcm"],
                  "properties": {
                    "emits_audio_pcm": {
                      "const": true
                    }
                  }
                }
              }
            },
            "required": ["stage_graph"]
          },
          "then": {
            "properties": {
              "supported_output_formats": {
                "contains": {
                  "enum": [
                    "pcm_s16le_16k_mono",
                    "pcm_s16le_24k_mono",
                    "wav",
                    "mp3",
                    "flac",
                    "ogg_opus",
                    "m4a_aac",
                    "webm_opus"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "management_mode": {
                "const": "external"
              }
            },
            "required": ["management_mode"]
          },
          "then": {
            "properties": {
              "release_tier": {
                "enum": ["best_effort", "experimental"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "loading_policy": {
                "const": "on_demand"
              }
            },
            "required": ["loading_policy"]
          },
          "then": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "idle_reclaim_cooldown_ms": {
                    "type": "integer",
                    "minimum": 1000
                  }
                },
                "required": ["idle_reclaim_cooldown_ms"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "management_mode": {
                "const": "managed"
              }
            },
            "required": ["management_mode"]
          },
          "then": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "supports_fencing_barrier": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "cancellation_mode": {
                    "const": "engine_abort_confirmed"
                  }
                },
                "required": ["cancellation_mode"]
              }
            },
            "required": ["cancellation_and_fencing"]
          },
          "then": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "supports_request_abort": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "cancellation_mode": {
                    "const": "connection_drop_with_quarantine"
                  }
                },
                "required": ["cancellation_mode"]
              }
            },
            "required": ["cancellation_and_fencing"]
          },
          "then": {
            "properties": {
              "cancellation_and_fencing": {
                "properties": {
                  "supports_request_abort": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "release_tier": {
                "const": "production"
              }
            },
            "required": ["release_tier"]
          },
          "then": {
            "properties": {
              "rate_and_segment_limits": {
                "properties": {
                  "hard_output_quota": {
                    "const": true
                  }
                }
              },
              "cancellation_and_fencing": {
                "properties": {
                  "supports_fencing_barrier": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "External_capacity_manifest_schema_json_Identifier": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
    },
    "External_capacity_manifest_schema_json_PoolId": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_PoolId"
    },
    "External_shared_identifiers_schema_json_PoolId": {
      "type": "string",
      "enum": [
        "asr-realtime",
        "tts-realtime",
        "asr-batch",
        "tts-batch",
        "voice-creation",
        "auxiliary"
      ],
      "description": "Logical capability resource pool identifier. Pools may span multiple host nodes."
    },
    "External_capacity_manifest_schema_json_ServiceClass": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_ServiceClass"
    },
    "External_shared_capability_domains_schema_json_ServiceClass": {
      "type": "string",
      "enum": ["realtime", "interactive", "batch"]
    },
    "External_capacity_manifest_schema_json_ManagementMode": {
      "type": "string",
      "enum": ["managed", "external"],
      "description": "managed requires exclusive execution-gateway ingress, full pool accounting, and fencing/abort barrier; external cannot claim production realtime SLO."
    },
    "External_capacity_manifest_schema_json_ReleaseTier": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_ReleaseTier"
    },
    "External_capacity_manifest_schema_json_LoadingPolicy": {
      "type": "string",
      "enum": ["resident", "on_demand"]
    },
    "External_capacity_manifest_schema_json_TopologyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_node_profile_id",
        "memory_architecture",
        "requires_shared_parent_budget",
        "topology_digest"
      ],
      "properties": {
        "host_node_profile_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Identifier",
          "description": "Logical node topology profile identifier validated during deployment qualification."
        },
        "memory_architecture": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_MemoryArchitecture"
        },
        "requires_shared_parent_budget": {
          "type": "boolean",
          "const": true,
          "description": "All instances mapped to the same host_node_id must share the node's parent physical budget."
        },
        "topology_digest": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Sha256Digest"
        }
      }
    },
    "External_capacity_manifest_schema_json_MemoryArchitecture": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_MemoryArchitecture"
    },
    "External_capacity_manifest_schema_json_Sha256Digest": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
    },
    "External_capacity_manifest_schema_json_SpeechTaskKind": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_SpeechTaskKind"
    },
    "External_shared_capability_domains_schema_json_SpeechTaskKind": {
      "type": "string",
      "enum": [
        "asr_realtime",
        "asr_full_segment_review",
        "asr_file",
        "tts_realtime",
        "tts_file",
        "voice_design",
        "voice_clone",
        "voice_validation",
        "forced_alignment",
        "speaker_diarization",
        "vad"
      ]
    },
    "External_capacity_manifest_schema_json_MediaFormat": {
      "type": "string",
      "enum": [
        "pcm_s16le_16k_mono",
        "pcm_s16le_24k_mono",
        "wav",
        "mp3",
        "flac",
        "ogg_opus",
        "m4a_aac",
        "webm_opus",
        "utf8_text",
        "json_segments"
      ]
    },
    "External_capacity_manifest_schema_json_StageResourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "stage_role",
        "engine_kind",
        "model_revision_digest",
        "required_for_admission",
        "emits_audio_pcm",
        "resident_budget",
        "loading_peak_budget",
        "per_slot_incremental_budget",
        "max_active_slots"
      ],
      "properties": {
        "stage_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Identifier"
        },
        "stage_role": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_StageRole"
        },
        "engine_kind": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_EngineKind"
        },
        "model_revision_digest": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Sha256Digest"
        },
        "required_for_admission": {
          "type": "boolean",
          "description": "True when this stage's readiness and incremental budget must be reserved atomically at admission time (e.g. 1.7B full_segment review or required alignment)."
        },
        "emits_audio_pcm": {
          "type": "boolean",
          "description": "True exactly for stages that emit PCM samples metered against max_output_audio_ms and the output sample intervals. Upstream token stages and text-only stages are false."
        },
        "resident_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector",
          "description": "Steady-state model resident budget counted once per running engine instance."
        },
        "loading_peak_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector",
          "description": "Peak memory and buffer footprint during weight load, warmup, and stage handoff."
        },
        "per_slot_incremental_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector",
          "description": "Incremental resource upper bound reserved per active execution slot."
        },
        "max_active_slots": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "External_capacity_manifest_schema_json_StageRole": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_StageRole"
    },
    "External_shared_capability_domains_schema_json_StageRole": {
      "type": "string",
      "enum": [
        "vad",
        "asr_preview",
        "asr_review",
        "asr_batch",
        "tts_talker",
        "tts_code2wav",
        "tts_connector",
        "voice_design",
        "voice_clone_base",
        "alignment",
        "diarization"
      ]
    },
    "External_capacity_manifest_schema_json_EngineKind": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_EngineKind"
    },
    "External_capacity_manifest_schema_json_ResourceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_active_slots",
        "device_memory_bytes",
        "host_memory_bytes",
        "unified_physical_memory_bytes",
        "cpu_decode_millicores",
        "host_pcm_buffer_bytes",
        "scratch_disk_bytes",
        "ingress_bandwidth_bps",
        "egress_bandwidth_bps",
        "object_storage_bytes"
      ],
      "properties": {
        "engine_active_slots": {
          "type": "integer",
          "minimum": 0
        },
        "device_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "host_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unified_physical_memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total combined physical memory charged against a unified-memory HostNode parent budget to prevent double-counting host and device memory."
        },
        "cpu_decode_millicores": {
          "type": "integer",
          "minimum": 0
        },
        "host_pcm_buffer_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "scratch_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ingress_bandwidth_bps": {
          "type": "integer",
          "minimum": 0
        },
        "egress_bandwidth_bps": {
          "type": "integer",
          "minimum": 0
        },
        "object_storage_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "External_capacity_manifest_schema_json_ResourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Frozen aggregation of stage_graph: resident_budget, loading_peak_budget and per_slot_incremental_budget are element-wise sums for every resource except engine_active_slots; per-slot engine_active_slots is the maximum stage value because one end-to-end execution occupies one slot in each stage. max_active_slots is the minimum of stage max_active_slots.",
      "required": [
        "resident_budget",
        "loading_peak_budget",
        "per_slot_incremental_budget",
        "max_active_slots",
        "realtime_reserved_slots"
      ],
      "properties": {
        "resident_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector"
        },
        "loading_peak_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector"
        },
        "per_slot_incremental_budget": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_ResourceVector"
        },
        "max_active_slots": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum max_active_slots across every declared stage_graph entry; optional stages constrain the binding too because they may execute."
        },
        "realtime_reserved_slots": {
          "type": "integer",
          "minimum": 0,
          "description": "Realtime reservation within max_active_slots; cannot exceed it."
        }
      }
    },
    "External_capacity_manifest_schema_json_RateAndSegmentLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_prefill_tokens_per_sec",
        "max_output_tokens_per_sec",
        "max_segment_audio_ms",
        "max_render_unit_codepoints",
        "max_output_audio_ms",
        "hard_output_quota"
      ],
      "properties": {
        "max_prefill_tokens_per_sec": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens_per_sec": {
          "type": "integer",
          "minimum": 1
        },
        "max_segment_audio_ms": {
          "type": "integer",
          "minimum": 100
        },
        "max_render_unit_codepoints": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_audio_ms": {
          "type": "integer",
          "minimum": 100
        },
        "hard_output_quota": {
          "type": "boolean",
          "description": "True only when the engine enforces a deterministic token/codec/sample ceiling prior to generation rather than relying on post-hoc disconnect."
        }
      }
    },
    "External_capacity_manifest_schema_json_CancellationAndFencingSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancellation_mode",
        "supports_request_abort",
        "supports_fencing_barrier",
        "worst_case_non_preemptible_ms",
        "max_drain_wait_ms",
        "idle_reclaim_cooldown_ms"
      ],
      "properties": {
        "cancellation_mode": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_CancellationMode"
        },
        "supports_request_abort": {
          "type": "boolean"
        },
        "supports_fencing_barrier": {
          "type": "boolean"
        },
        "worst_case_non_preemptible_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Measured worst-case non-preemptible execution duration per bounded unit."
        },
        "max_drain_wait_ms": {
          "type": "integer",
          "minimum": 1
        },
        "idle_reclaim_cooldown_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "External_capacity_manifest_schema_json_CancellationMode": {
      "type": "string",
      "enum": [
        "engine_abort_confirmed",
        "connection_drop_with_quarantine",
        "cooperative_checkpoint_only"
      ]
    },
    "External_capacity_manifest_schema_json_QualificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_report_id",
        "qualified_at",
        "expires_at",
        "config_bundle_digest",
        "verified_coexistence_profiles"
      ],
      "properties": {
        "qualification_report_id": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Identifier"
        },
        "qualified_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "config_bundle_digest": {
          "$ref": "#/$defs/External_capacity_manifest_schema_json_Sha256Digest"
        },
        "verified_coexistence_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CapacityManifest": {
      "$ref": "#/$defs/External_capacity_manifest_schema_json_Root"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/QualificationReport"
    },
    {
      "$ref": "#/$defs/CapacityManifest"
    }
  ]
}
