{
  "name": "SpeechNexus Design Tokens",
  "version": "1.1.0",
  "description": "Unified 3-tier Design Tokens for SpeechNexus (声枢 · Acoustic Hub) AdminUI and Workbench",
  "brand": {
    "name": "SpeechNexus",
    "cnName": "声枢",
    "archetype": "Acoustic Hub",
    "sloganCn": "自部署的语音服务与创作中枢",
    "sloganEn": "Self-Hosted Speech Engine & Studio"
  },
  "color": {
    "primitive": {
      "obsidian": {
        "950": { "$value": "oklch(0.12 0.015 250)", "$type": "color" },
        "900": { "$value": "oklch(0.16 0.018 250)", "$type": "color" },
        "850": { "$value": "oklch(0.20 0.020 250)", "$type": "color" },
        "800": { "$value": "oklch(0.26 0.022 250)", "$type": "color" },
        "700": { "$value": "oklch(0.34 0.020 250)", "$type": "color" },
        "500": { "$value": "oklch(0.55 0.018 250)", "$type": "color" },
        "300": { "$value": "oklch(0.72 0.012 250)", "$type": "color" },
        "100": { "$value": "oklch(0.92 0.008 250)", "$type": "color" },
        "50": { "$value": "oklch(0.98 0.002 250)", "$type": "color" }
      },
      "sand": {
        "50": { "$value": "oklch(0.985 0.008 85)", "$type": "color" },
        "100": { "$value": "oklch(0.965 0.012 85)", "$type": "color" },
        "200": { "$value": "oklch(0.920 0.015 85)", "$type": "color" },
        "300": { "$value": "oklch(0.850 0.018 85)", "$type": "color" },
        "700": { "$value": "oklch(0.420 0.025 85)", "$type": "color" },
        "900": { "$value": "oklch(0.180 0.028 85)", "$type": "color" }
      },
      "emerald": {
        "300": { "$value": "oklch(0.82 0.12 168)", "$type": "color" },
        "400": { "$value": "oklch(0.72 0.15 168)", "$type": "color" },
        "500": { "$value": "oklch(0.60 0.17 165)", "$type": "color" },
        "600": { "$value": "oklch(0.48 0.15 165)", "$type": "color" },
        "900": { "$value": "oklch(0.24 0.08 165)", "$type": "color" }
      },
      "cobalt": {
        "300": { "$value": "oklch(0.80 0.14 255)", "$type": "color" },
        "400": { "$value": "oklch(0.68 0.18 255)", "$type": "color" },
        "500": { "$value": "oklch(0.55 0.22 260)", "$type": "color" },
        "600": { "$value": "oklch(0.44 0.20 260)", "$type": "color" },
        "900": { "$value": "oklch(0.22 0.10 260)", "$type": "color" }
      },
      "amber": {
        "400": { "$value": "oklch(0.80 0.15 75)", "$type": "color" },
        "500": { "$value": "oklch(0.70 0.16 75)", "$type": "color" }
      },
      "rose": {
        "500": { "$value": "oklch(0.62 0.21 25)", "$type": "color" }
      },
      "violet": {
        "500": { "$value": "oklch(0.64 0.19 300)", "$type": "color" }
      },
      "coral": {
        "500": { "$value": "oklch(0.68 0.18 45)", "$type": "color" }
      }
    },
    "semantic": {
      "surface": {
        "page": { "$value": "var(--page)", "$type": "color" },
        "base": { "$value": "var(--surface)", "$type": "color" },
        "raised": { "$value": "var(--surface-raised)", "$type": "color" },
        "overlay": { "$value": "var(--surface-overlay)", "$type": "color" },
        "glass": { "$value": "var(--surface-glass)", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "var(--ink)", "$type": "color" },
        "secondary": { "$value": "var(--muted)", "$type": "color" },
        "subtle": { "$value": "var(--muted-subtle)", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "var(--line)", "$type": "color" },
        "strong": { "$value": "var(--line-strong)", "$type": "color" },
        "specular": { "$value": "var(--specular-line)", "$type": "color" }
      },
      "status": {
        "ready": {
          "text": { "$value": "var(--status-pill-ready-text)", "$type": "color" },
          "bg": { "$value": "var(--status-pill-ready-bg)", "$type": "color" }
        },
        "contract": {
          "text": { "$value": "var(--warning)", "$type": "color" },
          "bg": { "$value": "var(--warning-soft)", "$type": "color" },
          "border": { "$value": "var(--warning-border)", "$type": "color" }
        },
        "planned": {
          "text": { "$value": "var(--muted-subtle)", "$type": "color" },
          "border": { "$value": "var(--line)", "$type": "color" }
        }
      }
    },
    "domain": {
      "admin": {
        "accent": { "$value": "var(--nexus-color-emerald-500)", "$type": "color" },
        "accentDark": { "$value": "var(--nexus-color-emerald-400)", "$type": "color" },
        "tone": "admin",
        "description": "Precision Fleet Cockpit"
      },
      "workbench": {
        "accent": { "$value": "var(--nexus-color-cobalt-500)", "$type": "color" },
        "accentDark": { "$value": "var(--nexus-color-cobalt-300)", "$type": "color" },
        "tone": "workbench",
        "description": "Next-Gen Audio Atelier"
      },
      "audio": {
        "waveformWave": { "$value": "var(--waveform-wave)", "$type": "color" },
        "waveformProgress": { "$value": "var(--waveform-progress)", "$type": "color" },
        "waveformCursor": { "$value": "var(--waveform-cursor)", "$type": "color" }
      },
      "diarization": {
        "speaker1": { "$value": "var(--nexus-color-cobalt-500)", "$type": "color" },
        "speaker2": { "$value": "var(--nexus-color-emerald-500)", "$type": "color" },
        "speaker3": { "$value": "var(--nexus-color-violet-500)", "$type": "color" },
        "speaker4": { "$value": "var(--nexus-color-coral-500)", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "var(--font-sans)", "$type": "fontFamily" },
      "mono": { "$value": "var(--font-mono)", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.8125rem", "$type": "dimension" },
      "base": { "$value": "0.875rem", "$type": "dimension" },
      "md": { "$value": "1.0rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.375rem", "$type": "dimension" },
      "2xl": { "$value": "1.75rem", "$type": "dimension" }
    }
  },
  "radius": {
    "xs": { "$value": "var(--radius-xs)", "$type": "dimension" },
    "sm": { "$value": "var(--radius-sm)", "$type": "dimension" },
    "md": { "$value": "var(--radius-md)", "$type": "dimension" },
    "medium": { "$value": "var(--radius-medium)", "$type": "dimension" },
    "large": { "$value": "var(--radius-large)", "$type": "dimension" },
    "full": { "$value": "var(--radius-full)", "$type": "dimension" }
  },
  "elevation": {
    "glassBlur": { "$value": "var(--glass-blur)", "$type": "dimension" },
    "glassSaturation": { "$value": "var(--glass-saturation)", "$type": "number" },
    "shadowSm": { "$value": "var(--shadow-sm)", "$type": "shadow" },
    "shadow": { "$value": "var(--shadow)", "$type": "shadow" },
    "shadowLg": { "$value": "var(--shadow-lg)", "$type": "shadow" }
  }
}
