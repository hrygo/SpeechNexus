    "StreamBackpressure": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "type",
            "stream_id",
            "stream_epoch",
            "seq",
            "sent_at",
            "operation_id",
            "direction",
            "reason",
            "credit_samples"
          ],
          "properties": {
            "schema_version": {
              "const": "1.1.0"
            },
            "type": {
              "const": "stream.backpressure"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "direction": {
              "type": "string",
              "enum": [
                "input",
                "output"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "credit_exhausted",
                "consumer_slow",
                "engine_queue"
              ]
            },
            "credit_samples": {
              "type": "integer",
              "minimum": 0
            },
            "retry_after_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "StreamClose": {
