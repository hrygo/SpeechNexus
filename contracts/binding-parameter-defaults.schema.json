{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/binding-parameter-defaults.schema.json",
  "title": "BindingParameterDefaultsSnapshot",
  "description": "Registry-owned immutable declaration of profile-compatible default parameter values for one exact binding revision. Omission, explicit null and an explicit empty parameter map remain distinct. It is a declaration, not an engine-default probe or publication evidence. Parent identity, producer authority and final parameter compatibility are checked separately. It defines no create/get operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "binding_id",
    "binding_revision",
    "binding_revision_id",
    "parameters",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "snapshot_id": {
      "$ref": "shared/identifiers.schema.json#/$defs/Identifier"
    },
    "binding_id": {
      "$ref": "shared/identifiers.schema.json#/$defs/Identifier"
    },
    "binding_revision_id": {
      "$ref": "shared/identifiers.schema.json#/$defs/Identifier"
    },
    "binding_revision": {
      "$ref": "shared/identifiers.schema.json#/$defs/Revision"
    },
    "parameters": {
      "$ref": "#/$defs/BindingDefaultParameters"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "BindingDefaultParameters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit sparse canonical parameter fields. Nested objects retain their original required fields. No schema annotation supplies an omitted value. An explicit empty map declares no defaults and is not a substitute for an absent/unreadable snapshot.",
      "properties": {
        "asr": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/AsrParameterFields"
        },
        "tts": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/TtsParameterFields"
        },
        "output": {
          "$ref": "shared/profile-parameter-values.schema.json#/$defs/OutputParameterFields"
        }
      }
    }
  },
  "examples": [
    {
      "snapshot_id": "binding-defaults-synthetic-1",
      "binding_id": "asr-quality",
      "binding_revision": "1",
      "binding_revision_id": "binding-revision-synthetic-1",
      "created_at": "2026-10-24T00:00:00Z",
      "schema_version": "1.0.0",
      "parameters": {
        "asr": {
          "max_segment_ms": 15000
        }
      }
    }
  ]
}
