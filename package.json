{
  "name": "speechnexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @speechnexus/admin --filter @speechnexus/workbench dev",
    "build": "pnpm -r --if-present build",
    "lint:tokens": "node scripts/dev-env/validate-design-tokens.mjs",
    "test:tokens": "node --test tests/ci/design-tokens.test.mjs",
    "lint": "node scripts/dev-env/validate-design-tokens.mjs && eslint web packages/contracts/src --max-warnings 0 && echo \"ESLint: passed\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:contracts-sdk": "node --test tests/contract/test_openai_js_sdk.mjs",
    "format": "prettier --write \"web/**/*.{css,html,json,ts,tsx}\" \"*.{js,json,mjs,ts,yaml,yml}\" \"pnpm-workspace.yaml\" \".github/**/*.{yaml,yml}\" \"deploy/**/*.yaml\" \"packages/contracts/**/*.{ts,mts,mjs,json}\" \"scripts/dev-env/*design-token*.mjs\" \"tests/ci/*.mjs\"",
    "format:check": "prettier --check \"web/**/*.{css,html,json,ts,tsx}\" \"*.{js,json,mjs,ts,yaml,yml}\" \"pnpm-workspace.yaml\" \".github/**/*.{yaml,yml}\" \"deploy/**/*.yaml\" \"packages/contracts/**/*.{ts,mts,mjs,json}\" \"scripts/dev-env/*design-token*.mjs\" \"tests/ci/*.mjs\"",
    "browser:install": "playwright install chromium",
    "browser:smoke": "node scripts/dev-env/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openai": "7.43.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "ws": "8.22.0"
  }
}
