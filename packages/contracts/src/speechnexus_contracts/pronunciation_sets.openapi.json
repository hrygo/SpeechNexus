      "PronunciationContractViolation": {
        "description": "The deployment produced a pronunciation response that violates this\ncontract. Storage is reachable, so this is an implementation defect\nrather than an outage: it is not retryable and repeating the request\ncannot succeed until it is fixed. The reply still uses the public error\nenvelope.\n",
        "headers": {
          "Cache-Control": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Should-Retry": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "false"
