{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/internal/gateway-recovery.schema.json",
  "title": "GatewayRecoveryConfiguration",
  "x-nexus-version": "1.0.0",
  "$ref": "#/$defs/GatewayRecoveryConfig",
  "$defs": {
    "GatewayRecoveryConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Private server configuration, never a public request. All fields are explicit; parsing does not insert defaults. The node and gateway IDs come from the gateway's existing control identity. Its independent node component credential comes from the recovery Secret setting, never this file. Successful configuration starts the local worker automatically. Binding keys (pool_id, binding_revision_id) must be unique, checked by the native source before activation. The pass budget stops starting new rows, not an already running bounded operation. No setting grants execution, readiness qualification or budget release.",
      "x-nexus-file-limits": {
        "configuration_bytes": 524288,
        "ca_certificate_bytes": 1048576
      },
      "required": [
        "schema_version",
        "node",
        "bindings",
        "scan_interval_seconds",
        "batch_size",
        "request_timeout_seconds",
        "pass_budget_seconds"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "node": {
          "$ref": "#/$defs/RecoveryNode"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RecoveryBinding"
          }
        },
        "scan_interval_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3600
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 30,
          "description": "Total TLS/HTTP response deadline per source call, including body consumption. No retries or redirects."
        },
        "pass_budget_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 60,
          "description": "Monotonic budget for starting further rows. An active database/TLS operation finishes under its own deadline before shutdown releases ownership or closes the pool."
        }
      }
    },
    "RecoveryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "port", "tls_ca_file"],
      "properties": {
        "address": {
          "description": "Configured IP literal only. IPv4: RFC1918 or loopback. IPv6: fc00::/7, ::1 or 0:0:0:0:0:0:0:1. No DNS, scope ID, public/link-local destination, proxy, redirect or cloud fallback.",
          "oneOf": [
            {
              "type": "string",
              "format": "ipv4",
              "maxLength": 15,
              "pattern": "^(?:(?:10|127)\\.|172\\.(?:1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)"
            },
            {
              "type": "string",
              "format": "ipv6",
              "maxLength": 45,
              "pattern": "^(?:[fF][cCdD][0-9a-fA-F]{2}:|::1$|0:0:0:0:0:0:0:1$)"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tls_ca_file": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/",
          "description": "Absolute deployment-private CA certificate file. Read as a bounded regular file, never returned or logged. TLS must validate certificate and IP SAN."
        }
      }
    },
    "RecoveryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "binding_revision_id",
        "approved_template_id",
        "manifest_id",
        "config_digest"
      ],
      "properties": {
        "pool_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/PoolId"
        },
        "binding_revision_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "approved_template_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "manifest_id": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Identifier"
        },
        "config_digest": {
          "$ref": "../shared/identifiers.schema.json#/$defs/Sha256Digest"
        }
      }
    }
  }
}
