    "StreamTextAppend": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "type": "object",
          "required": [
            "operation_id",
            "attempt_id",
            "text_seq",
            "offset_codepoints",
            "text"
          ],
          "properties": {
            "type": {
              "const": "stream.text.append"
            },
            "text_seq": {
              "type": "integer",
              "minimum": 0
            },
            "offset_codepoints": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
