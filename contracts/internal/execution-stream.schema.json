          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "type": {
              "const": "stream.input.ack"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "accepted_through_sample": {
              "type": "integer",
              "minimum": 0
            },
            "credit_samples": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "StreamOutputAck": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "type": "object",
