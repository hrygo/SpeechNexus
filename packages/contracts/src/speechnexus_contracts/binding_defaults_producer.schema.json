{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindingDefaultsProducerContracts",
  "x-nexus-bindings-version": "0.1.0.dev0",
  "x-nexus-entrypoints": ["BindingDefaultsCreateRequest"],
  "$defs": {
    "BindingDefaultsCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "logical_model",
        "tasks",
        "engine",
        "artifact_set",
        "execution_recipe",
        "parameter_domains",
        "release_tier"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/External_admin_openapi_yaml_binding_id"
        },
        "supersedes_revision": {
          "$ref": "#/$defs/External_admin_openapi_yaml_supersedes_revision"
        },
        "logical_model": {
          "$ref": "#/$defs/External_admin_openapi_yaml_logical_model"
        },
        "tasks": {
          "$ref": "#/$defs/External_admin_openapi_yaml_tasks"
        },
        "engine": {
          "$ref": "#/$defs/External_admin_openapi_yaml_engine"
        },
        "artifact_set": {
          "$ref": "#/$defs/External_admin_openapi_yaml_artifact_set"
        },
        "execution_recipe": {
          "$ref": "#/$defs/External_admin_openapi_yaml_execution_recipe"
        },
        "parameter_domains": {
          "$ref": "#/$defs/External_admin_openapi_yaml_parameter_domains"
        },
        "release_tier": {
          "$ref": "#/$defs/External_admin_openapi_yaml_release_tier"
        },
        "parameter_defaults": {
          "$ref": "#/$defs/External_binding_parameter_defaults_schema_json_BindingDefaultParameters",
          "description": "Explicit sparse values. Omission creates no declaration; {} explicitly declares none. No schema default populates a value."
        }
      }
    },
    "External_admin_openapi_yaml_binding_id": {
      "$ref": "#/$defs/External_admin_openapi_yaml_Identifier"
    },
    "External_admin_openapi_yaml_Identifier": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
    },
    "External_shared_identifiers_schema_json_Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,126}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Opaque stable resource identifier. Prefixes are descriptive, not authorization claims."
    },
    "External_admin_openapi_yaml_supersedes_revision": {
      "$ref": "#/$defs/External_admin_openapi_yaml_Revision"
    },
    "External_admin_openapi_yaml_Revision": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
    },
    "External_shared_identifiers_schema_json_Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "maxLength": 19,
      "description": "Monotonic decimal revision represented as a string."
    },
    "External_admin_openapi_yaml_logical_model": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "External_admin_openapi_yaml_tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/External_model_binding_schema_json_SpeechTaskKind"
      }
    },
    "External_model_binding_schema_json_SpeechTaskKind": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_SpeechTaskKind"
    },
    "External_shared_capability_domains_schema_json_SpeechTaskKind": {
      "type": "string",
      "enum": [
        "asr_realtime",
        "asr_full_segment_review",
        "asr_file",
        "tts_realtime",
        "tts_file",
        "voice_design",
        "voice_clone",
        "voice_validation",
        "forced_alignment",
        "speaker_diarization",
        "vad"
      ]
    },
    "External_admin_openapi_yaml_engine": {
      "$ref": "#/$defs/External_model_binding_schema_json_EngineDescriptor"
    },
    "External_model_binding_schema_json_EngineDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "image_digest", "runtime_version"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/External_model_binding_schema_json_EngineKind"
        },
        "image_digest": {
          "$ref": "#/$defs/External_model_binding_schema_json_Sha256Digest"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "External_model_binding_schema_json_EngineKind": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_EngineKind"
    },
    "External_shared_capability_domains_schema_json_EngineKind": {
      "type": "string",
      "enum": ["vllm", "vllm_omni", "nemo", "qwen_forced_aligner", "onnx_runtime", "cpu_native"]
    },
    "External_model_binding_schema_json_Sha256Digest": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Sha256Digest"
    },
    "External_shared_identifiers_schema_json_Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "External_admin_openapi_yaml_artifact_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/External_model_binding_schema_json_ArtifactReference"
      }
    },
    "External_model_binding_schema_json_ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact_id", "digest", "media_type"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["weights", "tokenizer", "codec", "config", "vocab", "connector"]
        },
        "artifact_id": {
          "$ref": "#/$defs/External_model_binding_schema_json_Identifier"
        },
        "digest": {
          "$ref": "#/$defs/External_model_binding_schema_json_Sha256Digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "External_model_binding_schema_json_Identifier": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
    },
    "External_admin_openapi_yaml_execution_recipe": {
      "$ref": "#/$defs/External_model_binding_schema_json_ExecutionRecipe"
    },
    "External_model_binding_schema_json_ExecutionRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_revision", "capacity_manifest_id", "stage_roles"],
      "properties": {
        "recipe_revision": {
          "$ref": "#/$defs/External_model_binding_schema_json_Revision"
        },
        "capacity_manifest_id": {
          "$ref": "#/$defs/External_model_binding_schema_json_Identifier"
        },
        "stage_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_model_binding_schema_json_StageRole"
          }
        },
        "requires_complete_reservation": {
          "type": "boolean",
          "default": true,
          "description": "True when every stage, including required review or auxiliary work, must be admitted before execution starts."
        }
      }
    },
    "External_model_binding_schema_json_Revision": {
      "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
    },
    "External_model_binding_schema_json_StageRole": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_StageRole"
    },
    "External_shared_capability_domains_schema_json_StageRole": {
      "type": "string",
      "enum": [
        "vad",
        "asr_preview",
        "asr_review",
        "asr_batch",
        "tts_talker",
        "tts_code2wav",
        "tts_connector",
        "voice_design",
        "voice_clone_base",
        "alignment",
        "diarization"
      ]
    },
    "External_admin_openapi_yaml_parameter_domains": {
      "$ref": "#/$defs/External_model_binding_schema_json_ParameterDomains"
    },
    "External_model_binding_schema_json_ParameterDomains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": {
          "$ref": "#/$defs/External_model_binding_schema_json_AsrParameterDomain"
        },
        "tts": {
          "$ref": "#/$defs/External_model_binding_schema_json_TtsParameterDomain"
        },
        "voice": {
          "$ref": "#/$defs/External_model_binding_schema_json_VoiceParameterDomain"
        }
      },
      "minProperties": 1
    },
    "External_model_binding_schema_json_AsrParameterDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "max_segment_ms",
        "finalization_modes",
        "supports_prompt",
        "alignment_modes",
        "diarization_modes"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 35
          }
        },
        "max_segment_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "finalization_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_FinalizationMode"
          }
        },
        "supports_prompt": {
          "type": "boolean"
        },
        "supports_word_timestamps": {
          "type": "boolean"
        },
        "alignment_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_AuxiliaryMode"
          }
        },
        "diarization_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_AuxiliaryMode"
          }
        },
        "max_speakers": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 64
        },
        "supports_rollback_tokens": {
          "type": "boolean"
        }
      }
    },
    "External_shared_capability_domains_schema_json_FinalizationMode": {
      "type": "string",
      "enum": ["full_segment", "streaming_finalize"]
    },
    "External_shared_capability_domains_schema_json_AuxiliaryMode": {
      "type": "string",
      "enum": ["off", "required", "best_effort"]
    },
    "External_model_binding_schema_json_TtsParameterDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "audio_formats",
        "sample_rates_hz",
        "text_commit_modes",
        "audio_delivery_modes",
        "supports_instructions",
        "max_input_codepoints"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 35
          }
        },
        "audio_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_AudioFormat"
          }
        },
        "sample_rates_hz": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 8000,
            "maximum": 96000
          }
        },
        "text_commit_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_TextCommitMode"
          }
        },
        "audio_delivery_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_shared_capability_domains_schema_json_AudioDeliveryMode"
          }
        },
        "supports_instructions": {
          "type": "boolean"
        },
        "supports_speed": {
          "type": "boolean"
        },
        "speed_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4.0
            },
            "maximum": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4.0
            }
          }
        },
        "max_input_codepoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "supports_seed": {
          "type": "boolean"
        }
      }
    },
    "External_shared_capability_domains_schema_json_AudioFormat": {
      "type": "string",
      "enum": ["mp3", "wav", "pcm"]
    },
    "External_shared_capability_domains_schema_json_TextCommitMode": {
      "type": "string",
      "enum": ["explicit", "sentence"]
    },
    "External_shared_capability_domains_schema_json_AudioDeliveryMode": {
      "type": "string",
      "enum": ["complete", "chunked"]
    },
    "External_model_binding_schema_json_VoiceParameterDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_supported", "clone_supported", "reusable_voice_supported"],
      "properties": {
        "design_supported": {
          "type": "boolean"
        },
        "clone_supported": {
          "type": "boolean"
        },
        "preview_only_possible": {
          "type": "boolean"
        },
        "reusable_voice_supported": {
          "type": "boolean"
        },
        "validation_set_revisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/External_model_binding_schema_json_Revision"
          }
        }
      }
    },
    "External_admin_openapi_yaml_release_tier": {
      "$ref": "#/$defs/External_model_binding_schema_json_ReleaseTier"
    },
    "External_model_binding_schema_json_ReleaseTier": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_ReleaseTier"
    },
    "External_shared_capability_domains_schema_json_ReleaseTier": {
      "type": "string",
      "enum": ["experimental", "best_effort", "production"]
    },
    "External_binding_parameter_defaults_schema_json_BindingDefaultParameters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit sparse canonical parameter fields. Nested objects retain their original required fields. No schema annotation supplies an omitted value. An explicit empty map declares no defaults and is not a substitute for an absent/unreadable snapshot.",
      "properties": {
        "asr": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrParameterFields"
        },
        "tts": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsParameterFields"
        },
        "output": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_OutputParameterFields"
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_AsrParameterFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrLanguage"
        },
        "preview_interval_ms": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrPreviewIntervalMs"
        },
        "max_segment_ms": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrMaxSegmentMs"
        },
        "finalization": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrFinalization"
        },
        "final_deadline_ms": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrFinalDeadlineMs"
        },
        "auxiliary_deadline_ms": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrAuxiliaryDeadlineMs"
        },
        "rollback_tokens": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrRollbackTokens"
        },
        "turn_detection": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrTurnDetection"
        },
        "vocabulary_set_revision": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrVocabularySetRevision"
        },
        "alignment": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrAlignment"
        },
        "diarization": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_AsrDiarization"
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_AsrLanguage": {
      "$ref": "#/$defs/External_shared_language_schema_json_LanguageTag"
    },
    "External_shared_language_schema_json_LanguageTag": {
      "type": "string",
      "pattern": "^(auto|[a-z]{2,3}(-[A-Za-z0-9]{2,8})*)$",
      "maxLength": 35
    },
    "External_shared_profile_parameter_values_schema_json_AsrPreviewIntervalMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 5000
    },
    "External_shared_profile_parameter_values_schema_json_AsrMaxSegmentMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000,
      "description": "Must be greater than or equal to preview_interval_ms and is further bounded by the binding, auxiliary capabilities, and workspace policy at admission. JSON Schema cannot express the cross-field comparison; contract tests and runtime validation enforce it."
    },
    "External_shared_profile_parameter_values_schema_json_AsrFinalization": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_FinalizationMode"
    },
    "External_shared_profile_parameter_values_schema_json_AsrFinalDeadlineMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "External_shared_profile_parameter_values_schema_json_AsrAuxiliaryDeadlineMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000,
      "default": 5000
    },
    "External_shared_profile_parameter_values_schema_json_AsrRollbackTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32,
      "default": 5
    },
    "External_shared_profile_parameter_values_schema_json_AsrTurnDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "silence_duration_ms"],
      "properties": {
        "mode": {
          "$ref": "#/$defs/External_shared_capability_domains_schema_json_VadMode"
        },
        "silence_duration_ms": {
          "type": "integer",
          "minimum": 200,
          "maximum": 3000
        }
      }
    },
    "External_shared_capability_domains_schema_json_VadMode": {
      "type": "string",
      "enum": ["server_vad", "manual"]
    },
    "External_shared_profile_parameter_values_schema_json_AsrVocabularySetRevision": {
      "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_NullableResourceReference"
    },
    "External_shared_profile_parameter_values_schema_json_NullableResourceReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/External_shared_references_schema_json_ResourceReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "External_shared_references_schema_json_ResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Identifier"
        },
        "revision": {
          "$ref": "#/$defs/External_shared_identifiers_schema_json_Revision"
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_AsrAlignment": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_AuxiliaryMode"
    },
    "External_shared_profile_parameter_values_schema_json_AsrDiarization": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_AuxiliaryMode"
    },
    "External_shared_profile_parameter_values_schema_json_TtsParameterFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsLanguage"
        },
        "text_commit_mode": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsTextCommitMode"
        },
        "audio_delivery": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsAudioDelivery"
        },
        "speed": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsSpeed"
        },
        "instructions": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsInstructions"
        },
        "pronunciation_revision": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsPronunciationRevision"
        },
        "seed": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsSeed"
        },
        "planner": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_TtsPlanner"
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_TtsLanguage": {
      "$ref": "#/$defs/External_shared_language_schema_json_LanguageTag"
    },
    "External_shared_profile_parameter_values_schema_json_TtsTextCommitMode": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_TextCommitMode"
    },
    "External_shared_profile_parameter_values_schema_json_TtsAudioDelivery": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_AudioDeliveryMode"
    },
    "External_shared_profile_parameter_values_schema_json_TtsSpeed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0,
      "default": 1.0
    },
    "External_shared_profile_parameter_values_schema_json_TtsInstructions": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "External_shared_profile_parameter_values_schema_json_TtsPronunciationRevision": {
      "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_NullableResourceReference"
    },
    "External_shared_profile_parameter_values_schema_json_TtsSeed": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2147483647
    },
    "External_shared_profile_parameter_values_schema_json_TtsPlanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_chars", "max_wait_ms"],
      "properties": {
        "max_chars": {
          "type": "integer",
          "minimum": 40,
          "maximum": 400
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3000
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_OutputParameterFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcript_format": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_OutputTranscriptFormat"
        },
        "audio_format": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_OutputAudioFormat"
        },
        "save_artifacts": {
          "$ref": "#/$defs/External_shared_profile_parameter_values_schema_json_OutputSaveArtifacts"
        }
      }
    },
    "External_shared_profile_parameter_values_schema_json_OutputTranscriptFormat": {
      "$ref": "#/$defs/External_shared_capability_domains_schema_json_TranscriptFormat"
    },
    "External_shared_capability_domains_schema_json_TranscriptFormat": {
      "type": "string",
      "enum": ["json", "text", "verbose_json", "srt", "vtt"]
    },
