{
  "version": "0.1.0",
  "source": "speech-openapi.yaml",
  "schemas": [
    "JobCreateRequest",
    "Job",
    "JobList",
    "JobEvent",
    "JobCancellation",
    "AssetUploadRequest",
    "Asset",
    "Artifact",
    "Operation",
    "OperationCancellation",
    "ErrorResponse"
  ],
  "coordination": {
    "version": "1.0.0",
    "source": "internal/coordination-transactions.schema.json",
    "definitions_prefix": "/$defs/",
    "title": "CoordinationJobContract",
    "schemas": [
      "create_job",
      "TransactionResult",
      "acquire_owner",
      "renew_owner",
      "activate_owner",
      "query_outcome",
      "claim_job",
      "mark_execution_unknown",
      "create_runtime_intent",
      "observe_runtime",
      "record_execution_observation",
      "redact_execution_command",
      "append_interval",
      "quarantine_lease"
    ]
  },
  "profiles": {
    "admin": {
      "source": "admin-openapi.yaml",
      "schemas": ["WorkspaceCreateRequest", "WorkspacePatch"]
    },
    "workbench": {
      "source": "workbench-openapi.yaml",
      "schemas": [
        "ProjectCreateRequest",
        "ProjectPatch",
        "Project",
        "ProjectList",
        "TranscriptCreateRequest",
        "TranscriptRevisionCreateRequest",
        "Transcript",
        "TranscriptRevision",
        "TranscriptView",
        "TranscriptList",
        "WorkbenchStatus",
        "ErrorResponse",
        "DeletionPlanRequest",
        "DeletionCreateRequest",
        "DeletionPlan",
        "Deletion",
        "Meeting",
        "MeetingCreateRequest",
        "MeetingSealRequest",
        "MinutesCreateRequest",
        "MinutesJob"
      ],
      "schema_refs": {
        "DeletionPlanRequest": "shared/deletion.schema.json#/$defs/DeletionPlanRequest",
        "DeletionCreateRequest": "shared/deletion.schema.json#/$defs/DeletionCreateRequest",
        "DeletionPlan": "shared/deletion.schema.json#/$defs/DeletionPlan",
        "Deletion": "shared/deletion.schema.json#/$defs/Deletion"
      }
    },
    "execution": {
      "source": "internal/execution-control.openapi.yaml",
      "schemas": [
        "SubmitExecutionRequest",
        "SubmitExecutionResponse",
        "ExecutionStatusResponse",
        "AbortExecutionRequest",
        "GatewayFencingBarrierRequest",
        "GatewayFencingBarrierResponse",
        "ExecutionControlErrorResponse"
      ]
    },
    "runtime": {
      "source": "internal/runtime-control.openapi.yaml",
      "schemas": [
        "RuntimeInstanceIntentRequest",
        "RuntimeInstanceIntentResponse",
        "NodeReconcileRequest"
      ]
    },
    "realtime": {
      "source": "speech-openapi.yaml",
      "schemas": ["RealtimeSessionCreateRequest", "RealtimeSession", "PcmDescriptor"],
      "typescript_source": "speech",
      "client": false
    },
    "realtime_events": {
      "source": "realtime-events.schema.json",
      "version": "0.1.0",
      "format": "json-schema",
      "client": false,
      "definitions_prefix": "/$defs/",
      "schemas": ["RealtimeEvent", "TranscriptionEvent", "OpenAIPcmFormat"],
      "schema_refs": {
        "RealtimeEvent": "#"
      },
      "schema_unions": {
        "TranscriptionEvent": {
          "base": "#",
          "members": [
            "#/$defs/SessionUpdate",
            "#/$defs/InputAudioBufferAppend",
            "#/$defs/InputAudioBufferCommit",
            "#/$defs/InputAudioBufferClear",
            "#/$defs/SessionCreated",
            "#/$defs/SessionUpdated",
            "#/$defs/InputAudioBufferCommitted",
            "#/$defs/InputAudioBufferCleared",
            "#/$defs/InputAudioBufferSpeechStarted",
            "#/$defs/InputAudioBufferSpeechStopped",
            "#/$defs/TranscriptionDelta",
            "#/$defs/TranscriptionCompleted",
            "#/$defs/TranscriptionFailed",
            "#/$defs/ErrorEvent"
          ]
        }
      }
    }
  },
  "http_surfaces": {
    "assets": {
      "source": "speech-openapi.yaml",
      "paths": [
        "/v1/nexus/assets",
        "/v1/nexus/assets/{asset_id}",
        "/v1/nexus/assets/{asset_id}/content"
      ]
    },
    "workbench": {
      "source": "workbench-openapi.yaml",
      "validate": true,
      "paths": [
        "/v1/workbench/status",
        "/v1/workbench/projects",
        "/v1/workbench/projects/{project_id}",
        "/v1/workbench/projects/{project_id}/transcripts",
        "/v1/workbench/transcripts/{transcript_id}",
        "/v1/workbench/transcripts/{transcript_id}/revisions",
        "/v1/workbench/transcripts/{transcript_id}/revisions/{revision}",
        "/v1/workbench/deletion-plans",
        "/v1/workbench/deletions",
        "/v1/workbench/deletions/{deletion_id}",
        "/v1/workbench/projects/{project_id}/meetings",
        "/v1/workbench/meetings/{meeting_id}",
        "/v1/workbench/meetings/{meeting_id}/seal",
        "/v1/workbench/meetings/{meeting_id}/minutes",
        "/v1/workbench/meetings/{meeting_id}/minutes/{minutes_id}"
      ]
    }
  }
}
