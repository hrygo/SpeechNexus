            "stream_epoch",
            "seq",
            "sent_at",
            "operation_id",
            "attempt_id",
            "submit_intent_id",
            "fencing_token",
            "input_credit_samples",
            "output_credit_samples",
            "max_message_bytes"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "type": {
              "const": "stream.opened"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "sent_at": {
              "type": "string",
              "format": "date-time"
            },
            "operation_id": {
              "$ref": "#/$defs/Identifier"
            },
            "attempt_id": {
              "$ref": "#/$defs/Identifier"
            },
            "submit_intent_id": {
              "$ref": "#/$defs/Identifier"
            },
            "fencing_token": {
              "type": "integer",
              "minimum": 1
            },
            "input_credit_samples": {
              "type": "integer",
              "minimum": 0
            },
            "output_credit_samples": {
              "type": "integer",
              "minimum": 0
            },
            "max_message_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "StreamInputAck": {
      "allOf": [
