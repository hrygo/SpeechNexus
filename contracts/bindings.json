{
  "version": "0.1.0",
  "source": "speech-openapi.yaml",
  "schemas": [
    "JobCreateRequest",
    "Job",
    "JobList",
    "JobEvent",
    "JobCancellation",
    "AssetUploadRequest",
    "Asset",
    "Artifact",
    "Operation",
    "OperationCancellation",
    "ErrorResponse"
  ],
  "coordination": {
    "version": "1.0.0",
    "source": "internal/coordination-transactions.schema.json",
    "definitions_prefix": "/$defs/",
    "title": "CoordinationJobContract",
    "schemas": [
      "create_job",
      "TransactionResult",
      "acquire_owner",
      "renew_owner",
      "activate_owner",
      "query_outcome",
      "claim_job",
      "mark_execution_unknown",
      "create_runtime_intent",
      "observe_runtime",
      "record_execution_observation",
      "redact_execution_command",
      "append_interval",
      "quarantine_lease",
      "release_lease",
      "admit_recipe",
      "seal_barrier",
      "create_submit",
      "record_stop"
    ]
  },
  "profiles": {
    "admin": {
      "source": "admin-openapi.yaml",
      "schemas": [
        "WorkspaceCreateRequest",
        "WorkspacePatch",
        "Workspace",
        "WorkspaceList",
        "ErrorResponse",
        "ProfileRevisionCreateRequest",
        "ModelBindingCreateRequest",
        "ProfilePublicationRequest",
        "ProfileActivationRequest",
        "ProfilePublishedRevision"
      ]
    },
    "workbench": {
      "source": "workbench-openapi.yaml",
      "schemas": [
        "ProjectCreateRequest",
        "ProjectPatch",
        "Project",
        "ProjectList",
        "TranscriptCreateRequest",
        "TranscriptRevisionCreateRequest",
        "Transcript",
        "TranscriptRevision",
        "TranscriptView",
        "TranscriptList",
        "WorkbenchStatus",
        "ErrorResponse",
        "DeletionPlanRequest",
        "DeletionCreateRequest",
        "DeletionPlan",
        "Deletion",
        "Meeting",
        "MeetingCreateRequest",
        "MeetingSealRequest",
        "MinutesCreateRequest",
        "MinutesJob",
        "RenderUnitGenerationRequest",
        "RenderUnitGenerationAccepted",
        "TeleprompterUpdateRequest",
        "TeleprompterState",
        "SavedAsset",
        "SavedAssetCreateRequest",
        "Book",
        "BookCreateRequest",
        "Chapter",
        "ChapterCreateRequest",
        "RenderUnit",
        "RenderUnitCreateRequest",
        "RenderUnitPatch",
        "AssistantTurn",
        "AssistantTurnCreateRequest",
        "ExportArtifact",
        "ExportCreateRequest",
        "ExportJob",
        "BookList",
        "ChapterList",
        "RenderUnitList",
        "VoiceList",
        "VoiceSummary",
        "VoiceRevision",
        "WorkbenchStatusV2",
        "RenderUnitV2",
        "RenderUnitCreateRequestV2",
        "RenderUnitPatchV2",
        "RenderUnitListV2",
        "RenderUnitGenerationAcceptedV2",
        "ExportEvent"
      ],
      "schema_refs": {
        "DeletionPlanRequest": "shared/deletion.schema.json#/$defs/DeletionPlanRequest",
        "DeletionCreateRequest": "shared/deletion.schema.json#/$defs/DeletionCreateRequest",
        "DeletionPlan": "shared/deletion.schema.json#/$defs/DeletionPlan",
        "Deletion": "shared/deletion.schema.json#/$defs/Deletion"
      }
    },
    "execution": {
      "source": "internal/execution-control.openapi.yaml",
      "schemas": [
        "SubmitExecutionRequest",
        "SubmitExecutionResponse",
        "ExecutionStatusResponse",
        "AbortExecutionRequest",
        "GatewayFencingBarrierRequest",
        "GatewayFencingBarrierResponse",
        "ExecutionControlErrorResponse",
        "DrainInstanceRequest",
        "DrainInstanceResponse",
        "ExecutionStagingResult",
        "ExecutionStagingResultResponse"
      ]
    },
    "runtime": {
      "source": "internal/runtime-control.openapi.yaml",
      "schemas": [
        "RuntimeInstanceIntentRequest",
        "RuntimeInstanceIntentResponse",
        "NodeReconcileRequest",
        "RuntimeControlErrorResponse"
      ]
    },
    "realtime": {
      "source": "speech-openapi.yaml",
      "schemas": [
        "RealtimeSessionCreateRequest",
        "RealtimeSession",
        "PcmDescriptor"
      ],
      "typescript_source": "speech",
      "client": false
    },
    "realtime_events": {
      "source": "realtime-events.schema.json",
      "version": "0.1.0",
      "format": "json-schema",
      "client": false,
      "definitions_prefix": "/$defs/",
      "schemas": [
        "RealtimeEvent",
        "TranscriptionEvent",
        "OpenAIPcmFormat"
      ],
      "schema_refs": {
        "RealtimeEvent": "#"
      },
      "schema_unions": {
        "TranscriptionEvent": {
          "base": "#",
          "members": [
            "#/$defs/SessionUpdate",
            "#/$defs/InputAudioBufferAppend",
            "#/$defs/InputAudioBufferCommit",
            "#/$defs/InputAudioBufferClear",
            "#/$defs/SessionCreated",
            "#/$defs/SessionUpdated",
            "#/$defs/InputAudioBufferCommitted",
            "#/$defs/InputAudioBufferCleared",
            "#/$defs/InputAudioBufferSpeechStarted",
            "#/$defs/InputAudioBufferSpeechStopped",
            "#/$defs/TranscriptionDelta",
            "#/$defs/TranscriptionCompleted",
            "#/$defs/TranscriptionFailed",
            "#/$defs/ErrorEvent"
          ]
        }
      }
    },
    "scenario_profiles": {
      "source": "scenario-profile.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "client": false,
      "schemas": ["ScenarioProfileRevision"],
      "schema_refs": {
        "ScenarioProfileRevision": "#"
      }
    },
    "model_bindings": {
      "source": "model-binding.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "client": false,
      "schemas": ["ModelBindingRevision"],
      "schema_refs": {
        "ModelBindingRevision": "#"
      }
    },
    "gateway_recovery": {
      "source": "internal/gateway-recovery.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "client": false,
      "definitions_prefix": "/$defs/",
      "schemas": ["GatewayRecoveryConfig"]
    },
    "binding_defaults": {
      "source": "binding-parameter-defaults.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "client": false,
      "schemas": ["BindingParameterDefaultsSnapshot"],
      "schema_refs": {
        "BindingParameterDefaultsSnapshot": "#"
      }
    },
    "binding_defaults_producer": {
      "source": "binding-defaults-producer.openapi.yaml",
      "client": false,
      "schemas": [
        "BindingDefaultsCreateRequest"
      ]
    }
  },
  "http_surfaces": {
    "admin": {
      "source": "admin-openapi.yaml",
      "validate": true,
      "paths": [
        "/v1/nexus/workspaces",
        "/v1/nexus/workspaces/{workspace_id}"
      ],
      "operations": [
        "listWorkspaces",
        "getWorkspace"
      ]
    },
    "runtime": {
      "source": "internal/runtime-control.openapi.yaml",
      "validate": true,
      "paths": [
        "/internal/v1/nodes/{node_id}/instance-intents",
        "/internal/v1/nodes/{node_id}/instance-intents/{intent_id}",
        "/internal/v1/nodes/{node_id}/instances/{instance_id}/generations/{instance_generation}/verified-stop"
      ]
    },
    "assets": {
      "source": "speech-openapi.yaml",
      "paths": [
        "/v1/nexus/assets",
        "/v1/nexus/assets/{asset_id}",
        "/v1/nexus/assets/{asset_id}/content"
      ]
    },
    "workbench": {
      "source": "workbench-openapi.yaml",
      "validate": true,
      "paths": [
        "/v1/workbench/status",
        "/v1/workbench/projects",
        "/v1/workbench/projects/{project_id}",
        "/v1/workbench/projects/{project_id}/transcripts",
        "/v1/workbench/transcripts/{transcript_id}",
        "/v1/workbench/transcripts/{transcript_id}/revisions",
        "/v1/workbench/transcripts/{transcript_id}/revisions/{revision}",
        "/v1/workbench/deletion-plans",
        "/v1/workbench/deletions",
        "/v1/workbench/deletions/{deletion_id}",
        "/v1/workbench/projects/{project_id}/meetings",
        "/v1/workbench/meetings/{meeting_id}",
        "/v1/workbench/meetings/{meeting_id}/seal",
        "/v1/workbench/meetings/{meeting_id}/minutes",
        "/v1/workbench/meetings/{meeting_id}/minutes/{minutes_id}",
        "/v1/workbench/render-units/{unit_id}/generations",
        "/v1/workbench/projects/{project_id}/teleprompter",
        "/v1/workbench/projects/{project_id}/saved-assets",
        "/v1/workbench/saved-assets/{asset_id}",
        "/v1/workbench/projects/{project_id}/books",
        "/v1/workbench/books/{book_id}",
        "/v1/workbench/books/{book_id}/chapters",
        "/v1/workbench/chapters/{chapter_id}",
        "/v1/workbench/chapters/{chapter_id}/render-units",
        "/v1/workbench/render-units/{unit_id}",
        "/v1/workbench/projects/{project_id}/assistant-turns",
        "/v1/workbench/assistant-turns/{turn_id}",
        "/v1/workbench/assistant-turns/{turn_id}/cancellations",
        "/v1/workbench/books/{book_id}/exports",
        "/v1/workbench/exports/{export_id}",
        "/v1/workbench/exports/{export_id}/cancellations",
        "/v1/workbench/voices",
        "/v1/workbench/voices/{voice_id}/revisions/{revision}",
        "/v2/workbench/status",
        "/v2/workbench/chapters/{chapter_id}/render-units",
        "/v2/workbench/render-units/{unit_id}",
        "/v2/workbench/render-units/{unit_id}/generations",
        "/v1/workbench/saved-assets/{asset_id}/content",
        "/v1/workbench/exports/{export_id}/content",
        "/v1/workbench/exports/{export_id}/events"
      ]
    },
    "profile": {
      "source": "admin-openapi.yaml",
      "validate": true,
      "typescript_source": "admin",
      "paths": [
        "/v1/nexus/admin/profiles",
        "/v1/nexus/admin/profiles/{profile_id}/revisions/{revision}"
      ],
      "operations": ["createProfileRevision", "getProfileRevisionForAdministration"]
    },
    "profile_lifecycle": {
      "source": "admin-openapi.yaml",
      "validate": true,
      "typescript_source": "admin",
      "paths": [
        "/v1/nexus/admin/profiles/{profile_id}/revisions/{revision}/publications",
        "/v1/nexus/admin/profiles/{profile_id}/revisions/{revision}/activations"
      ],
      "operations": ["publishProfileRevision", "activatePublishedProfileRevision"]
    },
    "binding": {
      "source": "admin-openapi.yaml",
      "validate": true,
      "typescript_source": "admin",
      "paths": [
        "/v1/nexus/admin/model-bindings",
        "/v1/nexus/admin/model-bindings/{binding_id}/revisions/{revision}"
      ],
      "operations": ["createModelBindingDraft", "getModelBindingRevision"]
    },
    "binding_defaults": {
      "source": "binding-defaults-producer.openapi.yaml",
      "validate": true,
      "typescript_source": "binding_defaults_producer",
      "paths": [
        "/v1/nexus/admin/model-bindings",
        "/v1/nexus/admin/model-bindings/{binding_id}/revisions/{revision}/parameter-defaults"
      ],
      "operations": [
        "createModelBindingDraft",
        "getModelBindingParameterDefaults"
      ]
    }
  }
}
