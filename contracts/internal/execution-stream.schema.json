        {
          "type": "object",
          "required": [
            "schema_version",
            "type",
            "stream_id",
            "stream_epoch",
            "seq",
            "sent_at",
            "operation_id",
            "consumed_through_sample",
            "credit_samples"
          ],
          "properties": {
            "schema_version": {
              "const": "1.1.0"
            },
            "type": {
