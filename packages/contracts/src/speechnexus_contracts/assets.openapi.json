    "headers": {
      "XRequestId": {
        "description": "Validated client request ID or a server-generated correlation ID.",
        "schema": {
          "type": "string"
        }
      },
      "AssetLocation": {
        "description": "Relative URL of the original Asset; its existence or readiness may be unknown.",
        "schema": {
          "type": "string"
        }
      },
      "NoOrdinaryRetry": {
        "description": "Suppress ordinary SDK retries; reconcile the original identity instead.",
        "schema": {
          "type": "string",
          "const": "false"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying a capacity or cancellation coordination request.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "AcceptRanges": {
        "schema": {
          "type": "string",
          "const": "bytes"
        }
      },
      "ContentLength": {
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "ContentRange": {
        "schema": {
          "type": "string",
          "pattern": "^bytes [0-9]+-[0-9]+/[0-9]+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request, invalid JSON, invalid audio, or unknown field.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Shared service credential required or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Origin/Host policy rejected the request or the feature is disabled.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found or not visible to the requested workspace.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AssetReceiveTimeout": {
        "description": "The bounded upload receive deadline expired before reservation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AssetUploadConflict": {
        "description": "Idempotency fingerprint conflict or an original upload remains in progress.\nasset_upload_in_progress does not represent an Operation. Query the original\nAsset via Location; do not create a new upload to recover an uncertain one.\n",
        "headers": {
          "Location": {
            "$ref": "#/components/headers/AssetLocation"
          },
          "X-Should-Retry": {
            "$ref": "#/components/headers/NoOrdinaryRetry"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Gone": {
        "description": "Content or event history has expired and is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Upload or request body exceeds the declared bound.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Unsupported parameter, incompatible profile, or async_required.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Quota or queue limit exceeded; follow Retry-After.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AssetUploadUnavailable": {
        "description": "Storage, retention configuration or inspection is unavailable, or an original\ncommit/PUT is unknown. Unknown results are not ordinary retry permission.\nLocation is present when an original Asset identity is known. Without an\nIdempotency-Key a new request is a new logical upload, not guaranteed recovery.\n",
        "headers": {
          "Location": {
            "$ref": "#/components/headers/AssetLocation"
          },
          "X-Should-Retry": {
            "$ref": "#/components/headers/NoOrdinaryRetry"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Backend or capacity unavailable; retry only when `retryable` is true.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AssetRangeNotSatisfiable": {
        "description": "A malformed, multiple or unsatisfiable single byte range.",
        "headers": {
          "Content-Range": {
            "schema": {
              "type": "string",
              "pattern": "^bytes \\*/[0-9]+$"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "SharedServiceKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional deployment-wide shared credential. It grants access to the\nshared deployment, not a user identity. When disabled, any Authorization\nheader value is accepted for SDK compatibility and is not interpreted as\na user.\n"
      }
    }
  }
}
