#!/bin/sh
# Sourced by the official nginx entrypoint before template substitution.
validate_origin() {
    printf '%s\n' "$1" | awk '
      BEGIN { ok = 0 }
      /^https?:\/\/[A-Za-z0-9.-]+:[0-9]+$/ {
        value = $0
        sub(/^https?:\/\//, "", value)
        split(value, parts, ":")
        host = parts[1]; port = parts[2]
        if (port + 0 >= 1 && port + 0 <= 65535 &&
            host !~ /^\./ && host !~ /\.$/ && host !~ /\.\./ &&
            host !~ /(^|\.)-/ && host !~ /-(\.|$)/) {
          ok = 1
        }
      }
      END { if (!ok || NR != 1) exit 1; print host }
    '
}
WEB_SPEECH_HOST=$(validate_origin "${WEB_SPEECH_UPSTREAM:-}") || {
    echo "invalid WEB_SPEECH_UPSTREAM" >&2; exit 1;
}
WEB_WORKBENCH_HOST=$(validate_origin "${WEB_WORKBENCH_UPSTREAM:-}") || {
    echo "invalid WEB_WORKBENCH_UPSTREAM" >&2; exit 1;
}
printf '%s\n' "${WEB_DNS_RESOLVER:-}" | awk -F. '
  NF == 4 {
    for (i = 1; i <= 4; i++)
      if ($i !~ /^[0-9]+$/ || $i + 0 > 255) exit 1
    valid = 1
  }
  END { if (!valid || NR != 1) exit 1 }
' || { echo "invalid WEB_DNS_RESOLVER" >&2; exit 1; }
export WEB_SPEECH_HOST WEB_WORKBENCH_HOST
