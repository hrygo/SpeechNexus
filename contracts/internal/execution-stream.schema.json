            },
            "type": {
              "const": "stream.close"
            },
            "stream_id": {
              "$ref": "#/$defs/Identifier"
            },
            "stream_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "seq": {
              "type": "integer",
              "minimum": 0
