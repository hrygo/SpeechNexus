{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechnexus.internal/contracts/shared/errors.schema.json",
  "title": "SpeechNexusPublicErrors",
  "description": "Single source of truth for the OpenAI-compatible public error envelope shared by the speech, realtime, admin, and workbench public protocols. Internal control-plane errors add their own diagnostic fields instead of reusing this envelope.",
  "$defs": {
    "ErrorType": {
      "type": "string",
      "enum": [
        "invalid_request_error",
        "authentication_error",
        "permission_error",
        "not_found_error",
        "rate_limit_error",
        "api_error",
        "service_unavailable_error"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "type",
        "message",
        "param",
        "request_id",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "description": "Stable machine-readable error code."
        },
        "type": {
          "$ref": "#/$defs/ErrorType"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "param": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "nexus": {
          "$ref": "#/$defs/OperationRecovery"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "operation_in_progress",
                  "response_not_replayable"
                ]
              }
            }
          },
          "then": {
            "required": [
              "nexus"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "response_not_replayable"
              }
            }
          },
          "then": {
            "properties": {
              "nexus": {
                "required": [
                  "receipt"
                ]
              }
            }
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      }
    },
    "OperationRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "receipt": {
          "$ref": "receipts.schema.json#/$defs/ExecutionReceipt"
        }
      },
      "description": "Query GET /v1/nexus/operations/{operation_id}. This identity is the original execution; retrying never creates a second execution."
    }
  }
}
