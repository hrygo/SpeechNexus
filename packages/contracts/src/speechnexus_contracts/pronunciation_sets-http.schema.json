    "PronunciationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "id": ["expected_revision"],
        "expected_revision": ["id"]
      },
      "required": ["encoding", "entries"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "encoding": {
          "type": "string",
          "enum": ["pinyin", "ipa"]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/External_voice_resource_schema_json_PronunciationEntry"
          }
        },
        "publish": {
          "type": "boolean",
          "default": false,
