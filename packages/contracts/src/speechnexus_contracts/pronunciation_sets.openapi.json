      "PronunciationCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "dependentRequired": {
          "id": ["expected_revision"],
          "expected_revision": ["id"]
        },
        "required": ["encoding", "entries"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "expected_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "encoding": {
            "type": "string",
            "enum": ["pinyin", "ipa"]
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/External_voice_resource_schema_json_PronunciationEntry"
            }
          },
          "publish": {
            "type": "boolean",
            "default": false,
            "description": "Draft semantics only. Omission and `false` both create an immutable draft revision; `true` is rejected with 422 `pronunciation_publication_not_supported`. This field never publishes a set, selects a default, or qualifies pronunciation."
          }
        }
      },
