    "External_voice_resource_schema_json_VoiceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["designed", "cloned", "builtin"]
        },
        "draft_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/External_voice_resource_schema_json_Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/External_voice_resource_schema_json_Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_asset_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/External_voice_resource_schema_json_Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "draft_id": {
                "type": "null"
              },
              "draft_revision": {
                "type": "null"
              },
              "source_asset_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "designed"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["draft_id", "draft_revision"],
            "properties": {
              "draft_id": {
                "not": {
                  "type": "null"
                }
              },
              "draft_revision": {
                "not": {
                  "type": "null"
                }
              },
              "source_asset_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cloned"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["draft_id", "draft_revision", "source_asset_digest"],
            "properties": {
              "draft_id": {
                "not": {
                  "type": "null"
                }
              },
              "draft_revision": {
                "not": {
                  "type": "null"
                }
              },
              "source_asset_digest": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
